@@ -14,6 +14,17 @@
 #ifndef _TKPORT
 #define _TKPORT
 
+/*
+ * PROVISIONAL (Android port, ADR 0002 "Stub tables"): Tk's own Xlib-shaped
+ * function declarations (tkIntXlibDecls.h) exist only in the Windows and macOS
+ * sections. Android implements the same API natively, so it selects the macOS
+ * section. This must be defined before tk.h is read. The upstream-quality form
+ * is a dedicated ANDROID section in generic/tk.decls.
+ */
+#if defined(__ANDROID__) && !defined(MAC_OSX_TCL)
+#   define MAC_OSX_TCL 1
+#endif
+
 #if defined(_WIN32)
 #   include "tkWinPort.h"
 #endif
