# Single source of truth for every pinned external input.
# Sourced by tools/*.sh. Changing a pin means changing it here, in
# docs/dependency-inventory.md, and (for Tcl/Tk) re-checking upstream/patches.

# --- Tcl / Tk (see docs/adr/0001-baseline.md) ---------------------------
TCL_VERSION=9.0.4
TCL_URL=https://downloads.sourceforge.net/project/tcl/Tcl/9.0.4/tcl9.0.4-src.tar.gz
TCL_SHA256=d0aed49230bc02a65c1e0229e65f34590a4b037ec40d546f32573b467f7551ea

TK_VERSION=9.0.4
TK_URL=https://downloads.sourceforge.net/project/tcl/Tcl/9.0.4/tk9.0.4-src.tar.gz
TK_SHA256=d7a146d2917eb8b5cc95276dbf0e3d03c7464d2b19c1675357857c989301dbb4

# --- Android NDK ---------------------------------------------------------
# SHA-1 is the value Google publishes in repository2-3.xml.
NDK_RELEASE=r29
NDK_REVISION=29.0.14206865
NDK_URL=https://dl.google.com/android/repository/android-ndk-r29-linux.zip
NDK_SHA1=87e2bb7e9be5d6a1c6cdf5ec40dd4e0c6d07c30b

# --- Android targets -----------------------------------------------------
# Minimum API level (Android 8.0). See ADR 0001 for the reasoning.
ANDROID_MIN_API=26
# First-class ABIs. armeabi-v7a / x86 are intentionally not built by default.
ANDROID_ABIS="arm64-v8a x86_64"

# --- Android SDK pieces for the host app (android-host/) -------------------
# Fetched as plain zips and SHA-1 verified against Google's repository2-3.xml.
# Using the SDK is subject to the Android SDK licence terms.
SDK_PLATFORM_API=35
SDK_PLATFORM_URL=https://dl.google.com/android/repository/platform-35_r02.zip
SDK_PLATFORM_SHA1=0bb560a90a7a2cbd0dd8348224d518b638fe7949
SDK_BUILD_TOOLS=35.0.0
SDK_BUILD_TOOLS_URL=https://dl.google.com/android/repository/build-tools_r35_linux.zip
SDK_BUILD_TOOLS_SHA1=2cfaa0bbb2336e9ec18ed3ecea84fa2e2af607bc

# --- Emulator for on-device tests (tools/run-emulator.sh) --------------------
# SHA-1s from Google's repository2-3.xml / sys-img2-3.xml. Android SDK licence applies.
EMULATOR_URL=https://dl.google.com/android/repository/emulator-linux_x64-16696583.zip
EMULATOR_SHA1=4296551c0fce5928710bf29bd1ce6d4888372051
SYSIMG_API=34
SYSIMG_URL=https://dl.google.com/android/repository/sys-img/android/x86_64-34_r04.zip
SYSIMG_SHA1=5f6a249f9bc3b1b4c459b13ce2eb646c9680bed1
PLATFORM_TOOLS_URL=https://dl.google.com/android/repository/platform-tools_r37.0.1-linux.zip
PLATFORM_TOOLS_SHA1=477254aa5f903c15cf51001717bdf347fb6b53e0
