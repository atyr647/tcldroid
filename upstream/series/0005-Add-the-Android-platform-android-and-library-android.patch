diff --git a/android/tkAndroidFont.c b/android/tkAndroidFont.c
new file mode 100644
index 0000000..75c836e
--- /dev/null
+++ b/android/tkAndroidFont.c
@@ -0,0 +1,357 @@
+/*
+ * tkAndroidFont.c --
+ *
+ *	Tk's font hooks on top of a TkATextEngine (FreeType in tests, Android's
+ *	android.graphics.Paint on a device). Tk asks for fonts by attributes;
+ *	the engine reports metrics, advance widths and renders glyph runs.
+ */
+
+#include "tkAndroidPriv.h"
+#include "tkFont.h"
+
+const TkATextEngine *tkAEngine;
+
+void
+TkAndroidSetTextEngine(const TkATextEngine *engine)
+{
+    tkAEngine = engine;
+}
+
+#define PW_SLOTS 256
+static struct { void *eng; const char *src; int n; unsigned hash; int w; } pwCache[PW_SLOTS];
+
+typedef struct AFont {
+    TkFont font;		/* must be first */
+    void *eng;
+    int ascii[128];		/* advance cache, -1 = unknown */
+} AFont;
+
+static void
+InitFont(AFont *f, Tk_Window tkwin, const TkFontAttributes *fa)
+{
+    TkAFontInfo info;
+    const char *family = fa->family != NULL ? fa->family : "sans-serif";
+    int px = (int) (TkFontGetPixels(tkwin, fa->size) + 0.5);
+    int i;
+
+    if (px < 6) px = 6;
+    f->eng = tkAEngine->open(family, px, fa->weight == TK_FW_BOLD, fa->slant == TK_FS_ITALIC, &info);
+    if (f->eng == NULL) {
+	f->eng = tkAEngine->open(NULL, px, fa->weight == TK_FW_BOLD, fa->slant == TK_FS_ITALIC, &info);
+    }
+    f->font.fid = (Font) (uintptr_t) f;
+    f->font.fa = *fa;
+    f->font.fa.family = Tk_GetUid(family);
+    f->font.fm.ascent = info.ascent;
+    f->font.fm.descent = info.descent;
+    f->font.fm.maxWidth = info.maxWidth;
+    f->font.fm.fixed = info.fixed;
+    for (i = 0; i < 128; i++) {
+	f->ascii[i] = -1;
+    }
+}
+
+TkFont *
+TkpGetFontFromAttributes(TkFont *tkFontPtr, Tk_Window tkwin, const TkFontAttributes *faPtr)
+{
+    AFont *f;
+
+    if (tkFontPtr == NULL) {
+	f = (AFont *) ckalloc(sizeof(AFont));
+	memset(f, 0, sizeof(AFont));
+    } else {
+	f = (AFont *) tkFontPtr;
+	TkpDeleteFont(tkFontPtr);
+    }
+    InitFont(f, tkwin, faPtr);
+    return &f->font;
+}
+
+TkFont *TkpGetNativeFont(Tk_Window tkwin, const char *name) { (void) tkwin; (void) name; return NULL; }
+
+void
+TkpDeleteFont(TkFont *tkFontPtr)
+{
+    AFont *f = (AFont *) tkFontPtr;
+
+    if (f->eng != NULL) {
+	TkAFlushTextCache();	/* cached masks are keyed by the engine's font handle */
+	memset(pwCache, 0, sizeof(pwCache));	/* ... and so are the prefix widths */
+	tkAEngine->close(f->eng);
+	f->eng = NULL;
+    }
+}
+
+/*
+ * Named system fonts. Sizes are in points and scale with the screen density
+ * (tk scaling = dpi/72): 8 pt is about 2.8 mm tall, comfortable on a phone.
+ */
+void
+TkpFontPkgInit(TkMainInfo *mainPtr)
+{
+    static const struct { const char *name, *family; int size; int bold; } fonts[] = {
+	{"TkDefaultFont", "sans-serif", 8, 0},
+	{"TkTextFont", "sans-serif", 8, 0},
+	{"TkFixedFont", "monospace", 8, 0},
+	{"TkMenuFont", "sans-serif", 8, 0},
+	{"TkHeadingFont", "sans-serif", 8, 1},
+	{"TkCaptionFont", "sans-serif", 8, 1},
+	{"TkSmallCaptionFont", "sans-serif", 7, 0},
+	{"TkIconFont", "sans-serif", 8, 0},
+	{"TkTooltipFont", "sans-serif", 7, 0},
+	{NULL, NULL, 0, 0}
+    };
+    Tk_Window tkwin = (Tk_Window) mainPtr->winPtr;
+    int i;
+
+    /* Called before the main window is fully linked to its TkMainInfo. */
+    if (mainPtr->winPtr->mainPtr == NULL) {
+	mainPtr->winPtr->mainPtr = mainPtr;
+    }
+    for (i = 0; fonts[i].name != NULL; i++) {
+	TkFontAttributes fa;
+
+	TkInitFontAttributes(&fa);
+	fa.family = Tk_GetUid(fonts[i].family);
+	fa.size = fonts[i].size;
+	fa.weight = fonts[i].bold ? TK_FW_BOLD : TK_FW_NORMAL;
+	fa.slant = TK_FS_ROMAN;
+	if (TkCreateNamedFont(mainPtr->interp, tkwin, fonts[i].name, &fa) != TCL_OK) {
+	    TkALog("named font %s failed: %s", fonts[i].name, Tcl_GetStringResult(mainPtr->interp));
+	}
+    }
+}
+
+static void
+AddFamily(void *ctx, const char *name)
+{
+    Tcl_ListObjAppendElement(NULL, (Tcl_Obj *) ctx, Tcl_NewStringObj(name, TCL_AUTO_LENGTH));
+}
+
+void
+TkpGetFontFamilies(Tcl_Interp *interp, Tk_Window tkwin)
+{
+    Tcl_Obj *list = Tcl_NewObj();
+
+    (void) tkwin;
+    if (tkAEngine != NULL && tkAEngine->families != NULL) {
+	tkAEngine->families(AddFamily, list);
+    }
+    Tcl_SetObjResult(interp, list);
+}
+
+void TkpGetSubFonts(Tcl_Interp *interp, Tk_Font tkfont) { (void) tkfont; Tcl_SetObjResult(interp, Tcl_NewObj()); }
+
+void
+TkpGetFontAttrsForChar(Tk_Window tkwin, Tk_Font tkfont, int c, struct TkFontAttributes *faPtr)
+{
+    (void) tkwin; (void) c;
+    *faPtr = ((TkFont *) tkfont)->fa;
+}
+
+/* ---- measuring ------------------------------------------------------------------------------------ */
+
+static int
+CharAdvance(AFont *f, const char *p, int len, int cp)
+{
+    int w;
+
+    if (cp >= 0 && cp < 128 && f->ascii[cp] >= 0) {
+	return f->ascii[cp];
+    }
+    w = tkAEngine->measure(f->eng, p, len);
+    if (cp >= 0 && cp < 128) {
+	f->ascii[cp] = w;
+    }
+    return w;
+}
+
+/*
+ * Width of the first `n` bytes of `source`, measured as one run. Scripts that join letters (Arabic),
+ * reorder or combine them (Indic, Hebrew with points, emoji sequences) have no meaningful per-character
+ * advance: the platform shapes the run, and the run is also what is drawn, so layout must use the same
+ * number. A small cache keeps repeated prefixes of the same string cheap (a text widget asks for many).
+ */
+static int
+PrefixWidth(AFont *f, const char *source, int n)
+{
+    unsigned h = (unsigned) ((uintptr_t) f->eng >> 4) * 2654435761u;
+    int i, w;
+
+    for (i = 0; i < n; i++) {
+	h = (h ^ (unsigned char) source[i]) * 16777619u;
+    }
+    i = (int) (h % PW_SLOTS);
+    if (pwCache[i].eng == f->eng && pwCache[i].hash == h && pwCache[i].n == n) {
+	return pwCache[i].w;
+    }
+    w = tkAEngine->measure(f->eng, source, n);
+    pwCache[i].eng = f->eng;
+    pwCache[i].hash = h;
+    pwCache[i].n = n;
+    pwCache[i].w = w;
+    return w;
+}
+
+static int
+HasNonAscii(const char *s, Tcl_Size n)
+{
+    Tcl_Size i;
+
+    for (i = 0; i < n; i++) {
+	if ((unsigned char) s[i] >= 0x80) {
+	    return 1;
+	}
+    }
+    return 0;
+}
+
+/* Tk_MeasureChars for runs with non-ASCII text: prefix widths instead of summed advances. */
+static int
+MeasureRun(AFont *f, const char *source, Tcl_Size numBytes, int maxPixels, int flags, int *lengthPtr)
+{
+    int lo = 0, hi, fit = 0, total, lastBreak = -1;
+    Tcl_Size i;
+    int *ends = (int *) ckalloc(sizeof(int) * ((size_t) numBytes + 1));
+    int count = 0;
+
+    for (i = 0; i < numBytes; ) {
+	int cp, len = (int) Tcl_UtfToUniChar(source + i, &cp);
+
+	if (len < 1) len = 1;
+	if (i + len > numBytes) len = (int) (numBytes - i);
+	i += len;
+	ends[count++] = (int) i;
+	if (cp == ' ' || cp == '\t') {
+	    lastBreak = count - 1;
+	}
+    }
+    total = PrefixWidth(f, source, (int) numBytes);
+    if (maxPixels < 0 || total <= maxPixels) {
+	fit = count;
+	*lengthPtr = total;
+    } else {
+	/* the largest number of characters whose prefix still fits */
+	lo = 0;
+	hi = count;
+	while (lo < hi) {
+	    int mid = (lo + hi + 1) / 2;
+
+	    if (PrefixWidth(f, source, ends[mid - 1]) <= maxPixels) lo = mid; else hi = mid - 1;
+	}
+	fit = lo;
+	if ((flags & TK_PARTIAL_OK) && fit < count && fit > 0
+		&& PrefixWidth(f, source, ends[fit - 1]) < maxPixels) {
+	    fit++;
+	}
+	if ((flags & TK_WHOLE_WORDS) && lastBreak >= 0 && lastBreak < fit) {
+	    fit = lastBreak + 1;
+	}
+	if (fit == 0 && (flags & TK_AT_LEAST_ONE) && count > 0) {
+	    fit = 1;
+	}
+	*lengthPtr = fit > 0 ? PrefixWidth(f, source, ends[fit - 1]) : 0;
+    }
+    i = fit > 0 ? ends[fit - 1] : 0;
+    ckfree(ends);
+    return (int) i;
+}
+
+int
+Tk_MeasureChars(Tk_Font tkfont, const char *source, Tcl_Size numBytes, int maxPixels,
+	int flags, int *lengthPtr)
+{
+    AFont *f = (AFont *) tkfont;
+    int i = 0, curX = 0, lastBreak = -1, lastBreakX = 0;
+    int stoppedEarly = 0;
+
+    if (numBytes > 0 && HasNonAscii(source, numBytes)) {
+	return MeasureRun(f, source, numBytes, maxPixels, flags, lengthPtr);
+    }
+    while (i < numBytes) {
+	int cp, len = (int) Tcl_UtfToUniChar(source + i, &cp), w;
+
+	if (len < 1) len = 1;
+	if (i + len > numBytes) len = (int) numBytes - i;
+	w = CharAdvance(f, source + i, len, cp);
+	if (maxPixels >= 0 && curX + w > maxPixels) {
+	    if ((flags & TK_PARTIAL_OK) && curX < maxPixels) {
+		curX += w;
+		i += len;
+	    }
+	    stoppedEarly = 1;
+	    break;
+	}
+	curX += w;
+	i += len;
+	if (cp == ' ' || cp == '\t') {
+	    lastBreak = i;
+	    lastBreakX = curX;
+	}
+    }
+    if (stoppedEarly && (flags & TK_WHOLE_WORDS) && lastBreak > 0) {
+	i = lastBreak;
+	curX = lastBreakX;
+    }
+    if (i == 0 && (flags & TK_AT_LEAST_ONE) && numBytes > 0) {
+	int cp, len = (int) Tcl_UtfToUniChar(source, &cp);
+
+	if (len < 1) len = 1;
+	i = len;
+	curX = CharAdvance(f, source, len, cp);
+    }
+    *lengthPtr = curX;
+    return i;
+}
+
+int
+Tk_MeasureCharsInContext(Tk_Font tkfont, const char *string, Tcl_Size numBytes,
+	Tcl_Size rangeStart, Tcl_Size rangeLength, int maxPixels, int flags, int *lengthPtr)
+{
+    (void) numBytes;
+    return Tk_MeasureChars(tkfont, string + rangeStart, rangeLength, maxPixels, flags, lengthPtr);
+}
+
+/* ---- drawing ------------------------------------------------------------------------------------------ */
+
+void
+Tk_DrawChars(Display *display, Drawable drawable, GC gc, Tk_Font tkfont,
+	const char *source, Tcl_Size numBytes, int x, int y)
+{
+    AFont *f = (AFont *) tkfont;
+    int width = 0;
+
+    TkADrawText(display, drawable, gc, f->eng, source, (int) numBytes, x, y);
+    if (f->font.fa.underline || f->font.fa.overstrike) {
+	Tk_MeasureChars(tkfont, source, numBytes, -1, 0, &width);
+	if (f->font.fa.underline) {
+	    XFillRectangle(display, drawable, gc, x, y + f->font.underlinePos, (unsigned) width,
+		    (unsigned) f->font.underlineHeight);
+	}
+	if (f->font.fa.overstrike) {
+	    int y0 = y - f->font.fm.ascent / 3;
+
+	    XFillRectangle(display, drawable, gc, x, y0, (unsigned) width,
+		    (unsigned) f->font.underlineHeight);
+	}
+    }
+}
+
+void
+Tk_DrawCharsInContext(Display *display, Drawable drawable, GC gc, Tk_Font tkfont,
+	const char *string, Tcl_Size numBytes, Tcl_Size rangeStart, Tcl_Size rangeLength,
+	int x, int y)
+{
+    (void) numBytes;
+    Tk_DrawChars(display, drawable, gc, tkfont, string + rangeStart, rangeLength, x, y);
+}
+
+void
+TkDrawAngledChars(Display *display, Drawable drawable, GC gc, Tk_Font tkfont,
+	const char *source, Tcl_Size numBytes, double x, double y, double angle)
+{
+    if (angle != 0.0) {
+	TkAStubCalled("TkDrawAngledChars (rotated text drawn unrotated)");
+    }
+    Tk_DrawChars(display, drawable, gc, tkfont, source, numBytes, (int) (x + 0.5), (int) (y + 0.5));
+}
diff --git a/android/tkAndroidInt.h b/android/tkAndroidInt.h
new file mode 100644
index 0000000..fee7084
--- /dev/null
+++ b/android/tkAndroidInt.h
@@ -0,0 +1,33 @@
+/*
+ * tkAndroidInt.h --
+ *
+ *	Platform-internal declarations for the Android port of Tk, selected by generic code with
+ *	"#elif defined(TK_ANDROID) #include "tkAndroidInt.h"" next to tkWinInt.h and tkMacOSXInt.h.
+ *
+ *	Android has no X server, so the in-process pointer/grab machinery that the Windows and macOS
+ *	ports use (generic/tkPointer.c) is needed; its platform hooks are declared below.
+ */
+#ifndef _TKANDROIDINT
+#define _TKANDROIDINT
+
+#ifndef _TKINT
+#include "tkInt.h"
+#endif
+
+#include "tkIntPlatDecls.h"  /* IWYU pragma: export */
+
+/* Optional Unix modules that Tk's init code may reference. */
+MODULE_SCOPE  int       Tktray_Init (Tcl_Interp* interp);
+MODULE_SCOPE  int       SysNotify_Init (Tcl_Interp* interp);
+MODULE_SCOPE  int       Cups_Init (Tcl_Interp* interp);
+
+/*
+ * Platform hooks required by generic/tkPointer.c (in-process mouse capture,
+ * as on Windows/macOS). Declared in tkIntPlatDecls.h only for those platforms.
+ */
+MODULE_SCOPE unsigned long TkpGetMS(void);
+MODULE_SCOPE void          TkpSetCapture(TkWindow *winPtr);
+MODULE_SCOPE Tk_Window     TkpGetCapture(void);
+MODULE_SCOPE void          TkpSetCursor(TkpCursor cursor);
+
+#endif /* _TKANDROIDINT */
diff --git a/android/tkAndroidPort.h b/android/tkAndroidPort.h
new file mode 100644
index 0000000..c1b5989
--- /dev/null
+++ b/android/tkAndroidPort.h
@@ -0,0 +1,107 @@
+/*
+ * tkAndroidPort.h --
+ *
+ *	Platform header for the Android port of Tk, modelled on
+ *	macosx/tkMacOSXPort.h: a Unix-like system that takes Tk's *own* bundled
+ *	Xlib-shaped types from tk/xlib/X11 (no system X11, no X server, no X
+ *	protocol). See docs/adr/0002-tk-backend-architecture.md.
+ *
+ *	Decisions marked PROVISIONAL are to be settled by the Phase 2 rendering
+ *	spike and recorded in the ADR.
+ */
+
+#ifndef _TKANDROIDPORT
+#define _TKANDROIDPORT
+
+/*
+ * NOTE: the macro MAC_OSX_TCL is defined at the top of generic/tkPort.h (patch
+ * 0001), because tk.h pulls in the Xlib declarations before this header is read.
+ * See that patch and ADR 0002 ("Stub tables").
+ */
+
+#include <stdio.h>
+#include <pwd.h>
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <ctype.h>
+#include <math.h>
+#include <string.h>
+#include <limits.h>
+#include <sys/types.h>
+#include <sys/file.h>
+#include <sys/select.h>
+#include <sys/stat.h>
+#ifndef _TCL
+#   include <tcl.h>
+#endif
+#include <sys/time.h>
+#include <time.h>
+#include <inttypes.h>
+#include <unistd.h>
+#if defined(__GNUC__) && !defined(__cplusplus)
+#   pragma GCC diagnostic ignored "-Wc++-compat"
+#endif
+#include <X11/Xlib.h>
+#include <X11/cursorfont.h>
+#include <X11/keysym.h>
+#include <X11/Xatom.h>
+#include <X11/Xfuncproto.h>
+#include <X11/Xutil.h>
+
+#define SELECT_MASK fd_set
+
+
+#ifndef MODULE_SCOPE
+#   ifdef __cplusplus
+#	define MODULE_SCOPE extern "C"
+#   else
+#	define MODULE_SCOPE extern
+#   endif
+#endif
+
+#ifndef NBBY
+#   define NBBY 8
+#endif
+
+/* Use Tk's internal keysym hash table instead of a system XStringToKeysym. */
+#define REDO_KEYSYM_LOOKUP
+
+/*
+ * Not meaningful on Android (no colormaps). TkpCmapStressed() and TkpSync() are
+ * real functions in the X11 section of tkIntPlatDecls.h, so they are provided by
+ * the platform layer (trivially), not as macros.
+ */
+#define TkpFreeColor(tkColPtr)
+#define TkSetPixmapColormap(p,c) {}
+
+/* Needed by the reused Unix button code (as in tkUnixPort.h): no native controls. */
+#define TkpButtonSetDefaults() {}
+#define TkpDestroyButton(butPtr) {}
+
+#define TkpPrintWindowId(buf,w) \
+	snprintf((buf), TCL_INTEGER_SPACE, "0x%lx", (unsigned long) (w))
+
+/*
+ * Pixel format: Tk pixel values are 0x00RRGGBB (TrueColor, red_mask 0x00FF0000).
+ * The screen buffer holds 0xFFRRGGBB, which Java's Bitmap.setPixels() takes as is.
+ */
+#define TkpGetPixel(p) \
+	((((unsigned long) ((p)->red >> 8) & 0xff) << 16) \
+	| (((unsigned long) ((p)->green >> 8) & 0xff) << 8) \
+	| ((unsigned long) ((p)->blue >> 8) & 0xff))
+
+/*
+ * PROVISIONAL: Tk's own double buffering is left ON (TK_NO_DOUBLE_BUFFERING is
+ * not defined) until the spike shows whether the backing bitmap makes it
+ * redundant, as it is on macOS.
+ */
+
+#include "tkIntXlibDecls.h"  /* IWYU pragma: export */
+
+/* Entry point hooks used by the application init code. */
+#define USE_CUSTOM_EXIT_PROC
+EXTERN int TkpWantsExitProc(void);
+EXTERN TCL_NORETURN void TkpExitProc(void *);
+
+#endif /* _TKANDROIDPORT */
diff --git a/android/tkAndroidPriv.h b/android/tkAndroidPriv.h
new file mode 100644
index 0000000..6c6d9c8
--- /dev/null
+++ b/android/tkAndroidPriv.h
@@ -0,0 +1,126 @@
+/*
+ * tkAndroidPriv.h --
+ *
+ *	Private declarations shared by the files of the Tk Android platform
+ *	layer. Tk's generic code never includes this.
+ *
+ *	Architecture (docs/adr/0002-tk-backend-architecture.md): there is no X
+ *	server. Windows and pixmaps are in-process records (TkADrawable). All
+ *	windows of the application share ONE screen pixel buffer owned by the
+ *	root drawable; every X-shaped drawing call is rasterised into it in C.
+ *	Text is the only thing delegated to the platform: a TkATextEngine measures
+ *	and renders glyph runs (FreeType on the build machine for tests, Android's
+ *	android.graphics.Paint through JNI on a device).
+ */
+#ifndef TKANDROIDPRIV_H
+#define TKANDROIDPRIV_H
+
+#include "tkInt.h"
+#include "tkAndroid.h"
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Pixels are 0xAARRGGBB; Tk "pixel" values are 0x00RRGGBB. */
+#define TKA_OPAQUE 0xFF000000u
+
+typedef struct TkARect { int x1, y1, x2, y2; } TkARect;	/* half-open */
+
+typedef struct TkARegion {
+    int n, cap;
+    TkARect *r;			/* disjoint rectangles */
+} TkARegion;
+
+typedef struct TkADrawable {
+    int isWindow;		/* else pixmap */
+    int depth;			/* 24, or 1 for bitmaps */
+    struct TkADrawable *parent;
+    struct TkADrawable *first, *last;	/* children, lowest first */
+    struct TkADrawable *next, *prev;	/* siblings in stacking order */
+    int x, y;			/* position within parent (windows) */
+    int w, h;
+    int mapped;
+    unsigned long bg;		/* background pixel */
+    int bgSet;
+    TkWindow *winPtr;		/* owner (NULL for the root) */
+    long eventMask;
+    uint32_t *pix;		/* pixel storage (pixmaps, and the root) */
+} TkADrawable;
+
+/* A Window/Pixmap id is the address of its TkADrawable, but Tk may still hold an id after the drawable
+ * is gone (it destroys a window subtree in an order the X server tolerates). TkADrawableOf checks the id
+ * against the set of live drawables and returns NULL for a stale one. */
+struct TkADrawable;
+struct TkADrawable *TkADrawableOf(uintptr_t id);
+void TkADrawableRegister(struct TkADrawable *d);
+void TkADrawableUnregister(struct TkADrawable *d);
+#define TKA_DRAWABLE(id)	(TkADrawableOf((uintptr_t)(id)))
+#define TKA_ID(d)		((Window)(uintptr_t)(d))
+
+typedef struct TkAState {
+    Display *display;
+    TkDisplay *dispPtr;
+    TkADrawable *root;
+    int width, height;		/* screen size in pixels */
+    double density;		/* pixels per inch */
+    int dirty;			/* screen buffer changed since last present */
+    TkARect dirtyRect;
+    Tcl_ThreadId tclThread;
+    int ptrX, ptrY;		/* last pointer position, root coordinates */
+    unsigned int ptrState;	/* button mask */
+} TkAState;
+
+extern TkAState tkA;
+
+/* ---- regions ---------------------------------------------------------------- */
+
+TkARegion *TkARegionNew(void);
+void TkARegionFree(TkARegion *r);
+void TkARegionClear(TkARegion *r);
+void TkARegionAddRect(TkARegion *r, TkARect rect);	/* union */
+void TkARegionIntersectRect(TkARegion *r, TkARect rect);
+void TkARegionSubtractRect(TkARegion *r, TkARect rect);
+void TkARegionCopy(TkARegion *dst, const TkARegion *src);
+
+/* ---- windows ---------------------------------------------------------------- */
+
+void TkAWindowOrigin(TkADrawable *d, int *x, int *y);	/* in root coords */
+TkADrawable *TkAWindowAt(int rootX, int rootY);	/* deepest mapped window */
+void TkAComputeClip(TkADrawable *d, TkARegion *clip);	/* visible region, root coords */
+int TkAIsViewable(TkADrawable *d);
+
+/* ---- drawing ---------------------------------------------------------------- */
+
+void TkAMarkDirty(TkARect r);
+void TkADrawText(Display *display, Drawable drawable, GC gc, void *platformFont,
+	const char *utf8, int nbytes, int x, int y);
+
+/* ---- events ------------------------------------------------------------------ */
+
+void TkAGenerateVisibility(TkADrawable *d, int state);
+void TkAGenerateExpose(TkADrawable *d, TkARect r);	/* r in window coords */
+unsigned long TkANextSerial(void);
+/* generic/tkPointer.c; declared only in the Windows/macOS sections of tkIntPlatDecls.h */
+void TkPointerDeadWindow(TkWindow *winPtr);
+void TkAFlushTextCache(void);	/* tkAndroidDraw.c */
+void TkAReady(void);	/* tkAndroidEvent.c: release the start-up frame hold */
+int TkAInitSystemCommands(Tcl_Interp *interp);	/* tkAndroidSystem.c */
+int TkAClipboardCmd(void *cd, Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[]);
+void TkAClipboardChanged(void);
+void TkAClipboardDisowned(void);	/* tkAndroidSelect.c: the system clipboard changed */
+void TkAFocusLost(TkWindow *winPtr);
+TkWindow *TkAActiveTop(void);
+void TkAHandleBack(void);
+void TkAWmScreenChanged(void);
+
+/* Declared in tkIntPlatDecls.h only for the Windows/macOS sections. */
+void TkCreateXEventSource(void);
+unsigned long TkpGetMS(void);
+
+/* ---- misc ---------------------------------------------------------------------- */
+
+void TkAStubCalled(const char *name);
+void TkALog(const char *fmt, ...);
+int TkAInitCommands(Tcl_Interp *interp);
+
+#endif /* TKANDROIDPRIV_H */
diff --git a/android/tkAndroidRegion.c b/android/tkAndroidRegion.c
new file mode 100644
index 0000000..41900eb
--- /dev/null
+++ b/android/tkAndroidRegion.c
@@ -0,0 +1,286 @@
+/*
+ * tkAndroidRegion.c --
+ *
+ *	Regions as lists of disjoint rectangles. Used both for Tk's X-shaped
+ *	Region API (XCreateRegion, XUnionRectWithRegion, ...) and internally for
+ *	clipping. Pure geometry: no platform dependencies.
+ */
+
+#include "tkAndroidPriv.h"
+
+TkARegion *
+TkARegionNew(void)
+{
+    return (TkARegion *) calloc(1, sizeof(TkARegion));
+}
+
+void
+TkARegionFree(TkARegion *r)
+{
+    if (r != NULL) {
+	free(r->r);
+	free(r);
+    }
+}
+
+void
+TkARegionClear(TkARegion *r)
+{
+    r->n = 0;
+}
+
+static void
+Append(TkARegion *r, int x1, int y1, int x2, int y2)
+{
+    if (x1 >= x2 || y1 >= y2) {
+	return;
+    }
+    if (r->n == r->cap) {
+	r->cap = r->cap ? r->cap * 2 : 8;
+	r->r = (TkARect *) realloc(r->r, (size_t) r->cap * sizeof(TkARect));
+    }
+    r->r[r->n].x1 = x1;
+    r->r[r->n].y1 = y1;
+    r->r[r->n].x2 = x2;
+    r->r[r->n].y2 = y2;
+    r->n++;
+}
+
+void
+TkARegionCopy(TkARegion *dst, const TkARegion *src)
+{
+    int i;
+
+    if (dst == src) {
+	return;
+    }
+    dst->n = 0;
+    for (i = 0; i < src->n; i++) {
+	Append(dst, src->r[i].x1, src->r[i].y1, src->r[i].x2, src->r[i].y2);
+    }
+}
+
+void
+TkARegionSubtractRect(TkARegion *r, TkARect s)
+{
+    int i, n = r->n;
+    TkARect *old = r->r;
+    TkARegion out = {0, 0, NULL};
+
+    /* Split every rectangle around s (up to four pieces each). */
+    for (i = 0; i < n; i++) {
+	TkARect a = old[i];
+
+	if (s.x2 <= a.x1 || s.x1 >= a.x2 || s.y2 <= a.y1 || s.y1 >= a.y2) {
+	    Append(&out, a.x1, a.y1, a.x2, a.y2);
+	    continue;
+	}
+	Append(&out, a.x1, a.y1, a.x2, s.y1 > a.y1 ? s.y1 : a.y1);	/* top */
+	Append(&out, a.x1, s.y2 < a.y2 ? s.y2 : a.y2, a.x2, a.y2);	/* bottom */
+	{
+	    int y1 = s.y1 > a.y1 ? s.y1 : a.y1;
+	    int y2 = s.y2 < a.y2 ? s.y2 : a.y2;
+
+	    Append(&out, a.x1, y1, s.x1 > a.x1 ? s.x1 : a.x1, y2);	/* left */
+	    Append(&out, s.x2 < a.x2 ? s.x2 : a.x2, y1, a.x2, y2);	/* right */
+	}
+    }
+    free(old);
+    *r = out;
+}
+
+void
+TkARegionIntersectRect(TkARegion *r, TkARect s)
+{
+    int i, j = 0;
+
+    for (i = 0; i < r->n; i++) {
+	TkARect a = r->r[i];
+
+	if (a.x1 < s.x1) a.x1 = s.x1;
+	if (a.y1 < s.y1) a.y1 = s.y1;
+	if (a.x2 > s.x2) a.x2 = s.x2;
+	if (a.y2 > s.y2) a.y2 = s.y2;
+	if (a.x1 < a.x2 && a.y1 < a.y2) {
+	    r->r[j++] = a;
+	}
+    }
+    r->n = j;
+}
+
+void
+TkARegionAddRect(TkARegion *r, TkARect s)
+{
+    if (s.x1 >= s.x2 || s.y1 >= s.y2) {
+	return;
+    }
+    TkARegionSubtractRect(r, s);	/* keep rectangles disjoint */
+    Append(r, s.x1, s.y1, s.x2, s.y2);
+}
+
+/*
+ * ---------------------------------------------------------------------------
+ * Tk's X-shaped Region API. Region is an opaque pointer type in Tk's Xlib
+ * header; it points at a TkARegion here.
+ * ---------------------------------------------------------------------------
+ */
+
+#define RGN(x) ((TkARegion *) (x))
+
+Region
+XCreateRegion(void)
+{
+    return (Region) TkARegionNew();
+}
+
+int
+XDestroyRegion(Region rgn)
+{
+    TkARegionFree(RGN(rgn));
+    return 1;
+}
+
+void
+TkpCopyRegion(TkRegion dst, TkRegion src)
+{
+    TkARegionCopy(RGN(dst), RGN(src));
+}
+
+int
+XUnionRectWithRegion(XRectangle *rect, Region src, Region dst)
+{
+    TkARect s;
+
+    s.x1 = rect->x;
+    s.y1 = rect->y;
+    s.x2 = rect->x + rect->width;
+    s.y2 = rect->y + rect->height;
+    if (RGN(dst) != RGN(src)) {
+	TkARegionCopy(RGN(dst), RGN(src));
+    }
+    TkARegionAddRect(RGN(dst), s);
+    return 1;
+}
+
+int
+XIntersectRegion(Region a, Region b, Region dst)
+{
+    TkARegion *out = TkARegionNew(), *tmp = TkARegionNew();
+    int i;
+
+    for (i = 0; i < RGN(b)->n; i++) {
+	TkARegionCopy(tmp, RGN(a));
+	TkARegionIntersectRect(tmp, RGN(b)->r[i]);
+	{
+	    int j;
+
+	    for (j = 0; j < tmp->n; j++) {
+		TkARegionAddRect(out, tmp->r[j]);
+	    }
+	}
+    }
+    TkARegionCopy(RGN(dst), out);
+    TkARegionFree(out);
+    TkARegionFree(tmp);
+    return 1;
+}
+
+int
+XSubtractRegion(Region a, Region b, Region dst)
+{
+    int i;
+
+    if (RGN(dst) != RGN(a)) {
+	TkARegionCopy(RGN(dst), RGN(a));
+    }
+    for (i = 0; i < RGN(b)->n; i++) {
+	TkARegionSubtractRect(RGN(dst), RGN(b)->r[i]);
+    }
+    return 1;
+}
+
+int
+XOffsetRegion(Region rgn, int dx, int dy)
+{
+    int i;
+
+    for (i = 0; i < RGN(rgn)->n; i++) {
+	RGN(rgn)->r[i].x1 += dx;
+	RGN(rgn)->r[i].x2 += dx;
+	RGN(rgn)->r[i].y1 += dy;
+	RGN(rgn)->r[i].y2 += dy;
+    }
+    return 1;
+}
+
+int
+XClipBox(Region rgn, XRectangle *box)
+{
+    TkARegion *r = RGN(rgn);
+    int i, x1 = 0, y1 = 0, x2 = 0, y2 = 0;
+
+    for (i = 0; i < r->n; i++) {
+	if (i == 0 || r->r[i].x1 < x1) x1 = r->r[i].x1;
+	if (i == 0 || r->r[i].y1 < y1) y1 = r->r[i].y1;
+	if (i == 0 || r->r[i].x2 > x2) x2 = r->r[i].x2;
+	if (i == 0 || r->r[i].y2 > y2) y2 = r->r[i].y2;
+    }
+    box->x = (short) x1;
+    box->y = (short) y1;
+    box->width = (unsigned short) (x2 - x1);
+    box->height = (unsigned short) (y2 - y1);
+    return 1;
+}
+
+int
+XRectInRegion(Region rgn, int x, int y, unsigned int width, unsigned int height)
+{
+    TkARegion *r = RGN(rgn);
+    long covered = 0, area = (long) width * (long) height;
+    int i;
+
+    for (i = 0; i < r->n; i++) {
+	int x1 = r->r[i].x1 > x ? r->r[i].x1 : x;
+	int y1 = r->r[i].y1 > y ? r->r[i].y1 : y;
+	int x2 = r->r[i].x2 < (int) (x + width) ? r->r[i].x2 : (int) (x + width);
+	int y2 = r->r[i].y2 < (int) (y + height) ? r->r[i].y2 : (int) (y + height);
+
+	if (x1 < x2 && y1 < y2) {
+	    covered += (long) (x2 - x1) * (y2 - y1);
+	}
+    }
+    if (covered == 0) {
+	return RectangleOut;
+    }
+    return covered >= area ? RectangleIn : RectanglePart;
+}
+
+/* Build a region from the opaque pixels of an alpha mask (shaped windows, -bitmap). */
+void
+TkpBuildRegionFromAlphaData(Region region, unsigned x, unsigned y,
+	unsigned width, unsigned height, unsigned char *data,
+	unsigned pixelStride, unsigned lineStride)
+{
+    unsigned i, j;
+
+    for (i = 0; i < height; i++) {
+	unsigned char *row = data + i * lineStride;
+
+	for (j = 0; j < width; ) {
+	    TkARect run;
+
+	    if (row[j * pixelStride] == 0) {
+		j++;
+		continue;
+	    }
+	    run.x1 = (int) (x + j);
+	    while (j < width && row[j * pixelStride] != 0) {
+		j++;
+	    }
+	    run.x2 = (int) (x + j);
+	    run.y1 = (int) (y + i);
+	    run.y2 = (int) (y + i + 1);
+	    TkARegionAddRect(RGN(region), run);
+	}
+    }
+}
diff --git a/android/tkAndroidSelect.c b/android/tkAndroidSelect.c
new file mode 100644
index 0000000..e4cb319
--- /dev/null
+++ b/android/tkAndroidSelect.c
@@ -0,0 +1,217 @@
+/*
+ * tkAndroidSelect.c --
+ *
+ *	Selection and clipboard.
+ *
+ *	PRIMARY (text selected in a widget) lives entirely inside Tk, as on every
+ *	platform: generic/tkSelect.c serves it directly while the owner is in this
+ *	process, and Android has no second application to hand it to.
+ *
+ *	CLIPBOARD is the Android system clipboard (ClipboardManager, via the host):
+ *	- `clipboard append` renders Tk's buffers to text and puts them on the system
+ *	  clipboard;
+ *	- `clipboard get` / `selection get -selection CLIPBOARD` read the system
+ *	  clipboard unless Tk itself still owns it;
+ *	- when another app (or the user) replaces the clipboard, Tk's ownership is dropped
+ *	  (TkAClipboardChanged), so Tk never serves stale text.
+ *	Only text is supported. Without host callbacks (headless tests) a private
+ *	in-process clipboard stands in, so scripts behave the same.
+ */
+
+#include "tkAndroidPriv.h"
+#include "tkSelect.h"
+
+static char *ourText;		/* what Tk last put on the clipboard (UTF-8), or NULL */
+static char *privateClip;	/* stand-in clipboard when the host has none */
+
+static char *
+Dup(const char *s)
+{
+    size_t n = strlen(s);
+    char *d = (char *) malloc(n + 1);
+
+    if (d != NULL) {
+	memcpy(d, s, n + 1);
+    }
+    return d;
+}
+
+/* The current clipboard text, malloc'd, or NULL if there is none. */
+static char *
+HostGet(void)
+{
+    if (tkAHost.getClipboard != NULL) {
+	return tkAHost.getClipboard();
+    }
+    return privateClip != NULL ? Dup(privateClip) : NULL;
+}
+
+static void
+HostSet(const char *text)
+{
+    if (tkAHost.setClipboard != NULL) {
+	tkAHost.setClipboard(text);
+	return;
+    }
+    free(privateClip);
+    privateClip = text != NULL ? Dup(text) : NULL;
+}
+
+/* All buffers of the STRING (or UTF8_STRING) target, joined. Caller frees. */
+static char *
+RenderBuffers(TkDisplay *dispPtr)
+{
+    TkClipboardTarget *t, *use = NULL;
+    TkClipboardBuffer *b;
+    size_t len = 0;
+    char *out, *p;
+
+    for (t = dispPtr->clipTargetPtr; t != NULL; t = t->nextPtr) {
+	if (t->type == XA_STRING || t->type == dispPtr->utf8Atom) {
+	    use = t;
+	    if (t->type == dispPtr->utf8Atom) {
+		break;
+	    }
+	}
+    }
+    if (use != NULL) {
+	for (b = use->firstBufferPtr; b != NULL; b = b->nextPtr) {
+	    len += (size_t) b->length;
+	}
+    }
+    out = (char *) malloc(len + 1);
+    if (out == NULL) {
+	return NULL;
+    }
+    p = out;
+    if (use != NULL) {
+	for (b = use->firstBufferPtr; b != NULL; b = b->nextPtr) {
+	    memcpy(p, b->buffer, (size_t) b->length);
+	    p += b->length;
+	}
+    }
+    *p = '\0';
+    return out;
+}
+
+void
+TkSelUpdateClipboard(TkWindow *winPtr, clipboardOption opt)
+{
+    TkDisplay *dispPtr = winPtr->dispPtr;
+    char *text;
+
+    if (opt == CLIPBOARD_APPEND) {
+	text = RenderBuffers(dispPtr);
+	if (text == NULL) {
+	    return;
+	}
+	free(ourText);
+	ourText = text;
+	HostSet(ourText);
+    } else if (opt == CLIPBOARD_CLEAR) {
+	free(ourText);
+	ourText = Dup("");
+	HostSet(NULL);
+    }
+}
+
+/* Tk disowned CLIPBOARD on purpose: what it put on the system clipboard goes with it. */
+static int externalChange;	/* set while Tk drops ownership because ANOTHER app replaced the clipboard */
+
+void
+TkAClipboardDisowned(void)
+{
+    if (externalChange) {
+	return;			/* the system clipboard now holds someone else's text: leave it */
+    }
+    if (ourText != NULL) {
+	free(ourText);
+	ourText = NULL;
+	HostSet(NULL);
+    }
+}
+
+/*
+ * Tcl thread: the system clipboard changed. If it no longer holds what Tk put there,
+ * Tk is no longer the owner.
+ */
+void
+TkAClipboardChanged(void)
+{
+    TkDisplay *dispPtr = tkA.dispPtr;
+    char *cur;
+    int same;
+
+    if (dispPtr == NULL || dispPtr->clipWindow == NULL || !dispPtr->clipboardActive) {
+	return;
+    }
+    cur = HostGet();
+    same = strcmp(cur != NULL ? cur : "", ourText != NULL ? ourText : "") == 0;
+    free(cur);
+    if (!same) {
+	externalChange = 1;
+	Tk_ClearSelection(dispPtr->clipWindow, dispPtr->clipboardAtom);
+	externalChange = 0;
+	free(ourText);
+	ourText = NULL;
+    }
+}
+
+/* Selection owned by "another application": only CLIPBOARD, only text. */
+int
+TkSelGetSelection(Tcl_Interp *interp, Tk_Window tkwin, Atom selection, Atom target,
+	Tk_GetSelProc *proc, void *clientData)
+{
+    TkDisplay *dispPtr = ((TkWindow *) tkwin)->dispPtr;
+    char *text;
+    int result;
+
+    if (selection == dispPtr->clipboardAtom
+	    && (target == XA_STRING || target == dispPtr->utf8Atom)
+	    && (text = HostGet()) != NULL) {
+	/* Android line ends are already \n. */
+	result = proc(clientData, interp, text);
+	free(text);
+	return result;
+    }
+    Tcl_SetObjResult(interp, Tcl_ObjPrintf(
+	    "%s selection doesn't exist or form \"%s\" not defined",
+	    Tk_GetAtomName(tkwin, selection), Tk_GetAtomName(tkwin, target)));
+    Tcl_SetErrorCode(interp, "TK", "SELECTION", "EXISTS", (char *) NULL);
+    return TCL_ERROR;
+}
+
+void
+TkClipCleanup(TkDisplay *dispPtr)
+{
+    (void) dispPtr;
+    free(ourText);
+    ourText = NULL;
+}
+
+void TkSelEventProc(Tk_Window tkwin, XEvent *ev) { (void) tkwin; (void) ev; }
+void TkSelPropProc(XEvent *ev) { (void) ev; }
+
+/*
+ * ::tkdroid::hostclipboard ?text?  --  test hook. With an argument, replace the system
+ * clipboard the way another application would (and notify Tk); without one, return
+ * the system clipboard's text ("" if none).
+ */
+int
+TkAClipboardCmd(void *cd, Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[])
+{
+    (void) cd;
+    if (objc == 2) {
+	HostSet(Tcl_GetString(objv[1]));
+	TkAQueueClipboardChanged();
+    } else if (objc == 1) {
+	char *t = HostGet();
+
+	Tcl_SetObjResult(interp, Tcl_NewStringObj(t != NULL ? t : "", TCL_AUTO_LENGTH));
+	free(t);
+    } else {
+	Tcl_WrongNumArgs(interp, 1, objv, "?text?");
+	return TCL_ERROR;
+    }
+    return TCL_OK;
+}
diff --git a/android/tkAndroidSystem.c b/android/tkAndroidSystem.c
new file mode 100644
index 0000000..54911af
--- /dev/null
+++ b/android/tkAndroidSystem.c
@@ -0,0 +1,307 @@
+/*
+ * tkAndroidSystem.c --
+ *
+ *	Device feedback and facts for scripts: vibration, haptics, sound effects,
+ *	`bell`, and ::tkdroid::device. Thin wrappers over host callbacks; with no host
+ *	(headless tests) they do nothing, so scripts need no guards.
+ *
+ *	  ::tkdroid::vibrate ms ?amplitude?
+ *	  ::tkdroid::haptic ?tick|click|heavy|confirm|reject?
+ *	  ::tkdroid::sound preload path ?path ...?
+ *	  ::tkdroid::sound play path ?-volume 0..1? ?-rate 0.5..2?
+ *	  ::tkdroid::sound stop
+ *	  ::tkdroid::device ?key?
+ */
+
+#include "tkAndroidPriv.h"
+
+int
+XBell(Display *d, int percent)
+{
+    (void) d; (void) percent;
+    if (tkAHost.bell != NULL) {
+	tkAHost.bell();
+    }
+    return 0;
+}
+
+static int
+VibrateCmd(void *cd, Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[])
+{
+    int ms, amp = 0;
+
+    (void) cd;
+    if (objc < 2 || objc > 3 || Tcl_GetIntFromObj(interp, objv[1], &ms) != TCL_OK
+	    || (objc == 3 && Tcl_GetIntFromObj(interp, objv[2], &amp) != TCL_OK)) {
+	Tcl_WrongNumArgs(interp, 1, objv, "milliseconds ?amplitude?");
+	return TCL_ERROR;
+    }
+    if (ms < 0 || ms > 5000 || amp < 0 || amp > 255) {
+	Tcl_SetObjResult(interp, Tcl_NewStringObj(
+		"milliseconds must be 0..5000 and amplitude 0..255", TCL_AUTO_LENGTH));
+	return TCL_ERROR;
+    }
+    if (ms > 0 && tkAHost.vibrate != NULL) {
+	tkAHost.vibrate(ms, amp);
+    }
+    return TCL_OK;
+}
+
+static int
+HapticCmd(void *cd, Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[])
+{
+    static const char *const kinds[] = {"tick", "click", "heavy", "confirm", "reject", NULL};
+    int k = TKA_HAPTIC_CLICK;
+
+    (void) cd;
+    if (objc > 2) {
+	Tcl_WrongNumArgs(interp, 1, objv, "?tick|click|heavy|confirm|reject?");
+	return TCL_ERROR;
+    }
+    if (objc == 2 && Tcl_GetIndexFromObj(interp, objv[1], kinds, "kind", 0, &k) != TCL_OK) {
+	return TCL_ERROR;
+    }
+    if (tkAHost.haptic != NULL) {
+	tkAHost.haptic(k);
+    }
+    return TCL_OK;
+}
+
+static int
+CheckReadable(Tcl_Interp *interp, const char *path)
+{
+    FILE *f = fopen(path, "rb");
+
+    if (f == NULL) {
+	Tcl_SetObjResult(interp, Tcl_ObjPrintf("couldn't read sound file \"%s\"", path));
+	return TCL_ERROR;
+    }
+    fclose(f);
+    return TCL_OK;
+}
+
+static int
+SoundCmd(void *cd, Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[])
+{
+    static const char *const subs[] = {"preload", "play", "stop", NULL};
+    int sub, i;
+
+    (void) cd;
+    if (objc < 2) {
+	Tcl_WrongNumArgs(interp, 1, objv, "preload|play|stop ?arg ...?");
+	return TCL_ERROR;
+    }
+    if (Tcl_GetIndexFromObj(interp, objv[1], subs, "subcommand", 0, &sub) != TCL_OK) {
+	return TCL_ERROR;
+    }
+    switch (sub) {
+    case 0:
+	for (i = 2; i < objc; i++) {
+	    if (CheckReadable(interp, Tcl_GetString(objv[i])) != TCL_OK) {
+		return TCL_ERROR;
+	    }
+	    if (tkAHost.soundPreload != NULL) {
+		tkAHost.soundPreload(Tcl_GetString(objv[i]));
+	    }
+	}
+	return TCL_OK;
+    case 1: {
+	double vol = 1.0, rate = 1.0;
+	const char *path;
+
+	if (objc < 3 || (objc % 2) == 0) {
+	    Tcl_WrongNumArgs(interp, 2, objv, "path ?-volume v? ?-rate r?");
+	    return TCL_ERROR;
+	}
+	path = Tcl_GetString(objv[2]);
+	for (i = 3; i < objc; i += 2) {
+	    const char *opt = Tcl_GetString(objv[i]);
+	    double *dst = strcmp(opt, "-volume") == 0 ? &vol : strcmp(opt, "-rate") == 0 ? &rate : NULL;
+
+	    if (dst == NULL) {
+		Tcl_SetObjResult(interp, Tcl_ObjPrintf("bad option \"%s\": must be -volume or -rate", opt));
+		return TCL_ERROR;
+	    }
+	    if (Tcl_GetDoubleFromObj(interp, objv[i + 1], dst) != TCL_OK) {
+		return TCL_ERROR;
+	    }
+	}
+	if (vol < 0) vol = 0;
+	if (vol > 1) vol = 1;
+	if (rate < 0.5) rate = 0.5;
+	if (rate > 2) rate = 2;
+	if (CheckReadable(interp, path) != TCL_OK) {
+	    return TCL_ERROR;
+	}
+	if (tkAHost.soundPlay != NULL) {
+	    tkAHost.soundPlay(path, (int) (vol * 1000), (int) (rate * 1000));
+	}
+	return TCL_OK;
+    }
+    default:
+	if (tkAHost.soundStop != NULL) {
+	    tkAHost.soundStop();
+	}
+	return TCL_OK;
+    }
+}
+
+/* ::tkdroid::device ?key? -- a dict of device/app facts (see MainActivity.systemInfo). */
+static int
+InfoCmd(void *cd, Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[])
+{
+    Tcl_Obj *d = Tcl_NewDictObj();
+    char *text, *p, *line;
+
+    (void) cd;
+    if (objc > 2) {
+	Tcl_WrongNumArgs(interp, 1, objv, "?key?");
+	return TCL_ERROR;
+    }
+    Tcl_DictObjPut(NULL, d, Tcl_NewStringObj("android", TCL_AUTO_LENGTH), Tcl_NewIntObj(1));
+    text = tkAHost.systemInfo != NULL ? tkAHost.systemInfo() : NULL;
+    for (p = text; p != NULL && *p != '\0'; ) {
+	char *tab, *nl;
+
+	line = p;
+	nl = strchr(p, '\n');
+	if (nl != NULL) {
+	    *nl = '\0';
+	    p = nl + 1;
+	} else {
+	    p += strlen(p);
+	}
+	tab = strchr(line, '\t');
+	if (tab != NULL) {
+	    *tab = '\0';
+	    Tcl_DictObjPut(NULL, d, Tcl_NewStringObj(line, TCL_AUTO_LENGTH),
+		    Tcl_NewStringObj(tab + 1, TCL_AUTO_LENGTH));
+	}
+    }
+    free(text);
+    if (objc == 2) {
+	Tcl_Obj *v = NULL;
+
+	Tcl_DictObjGet(NULL, d, objv[1], &v);
+	if (v == NULL) {
+	    Tcl_SetObjResult(interp, Tcl_ObjPrintf("unknown key \"%s\"", Tcl_GetString(objv[1])));
+	    Tcl_DecrRefCount(d);
+	    return TCL_ERROR;
+	}
+	Tcl_SetObjResult(interp, v);
+	Tcl_DecrRefCount(d);
+	return TCL_OK;
+    }
+    Tcl_SetObjResult(interp, d);
+    return TCL_OK;
+}
+
+/*
+ * ::tkdroid::request kind ?key value ...?  -> id
+ * The primitive under the asynchronous services (file picker, share, permissions...): hands the
+ * request to the host and returns an id; the answer arrives later through ::tkdroid::native result
+ * and is routed to the -command that the Tcl wrappers in android.tcl registered. With no host
+ * (headless tests) the answer is an immediate "error".
+ */
+static int
+RequestCmd(void *cd, Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[])
+{
+    static int nextId = 1;
+    Tcl_DString args;
+    Tcl_Size i;
+    int id = nextId++;
+
+    (void) cd;
+    if (objc < 2 || (objc % 2) != 0) {
+	Tcl_WrongNumArgs(interp, 1, objv, "kind ?key value ...?");
+	return TCL_ERROR;
+    }
+    Tcl_DStringInit(&args);
+    for (i = 2; i < objc; i += 2) {
+	const char *k = Tcl_GetString(objv[i]), *v = Tcl_GetString(objv[i + 1]);
+
+	Tcl_DStringAppend(&args, k, TCL_INDEX_NONE);
+	Tcl_DStringAppend(&args, "\t", 1);
+	for (; *v != '\0'; v++) {		/* tabs and newlines would break the framing */
+	    Tcl_DStringAppend(&args, (*v == '\t' || *v == '\n') ? " " : v, 1);
+	}
+	Tcl_DStringAppend(&args, "\n", 1);
+    }
+    if (tkAHost.request != NULL) {
+	tkAHost.request(id, Tcl_GetString(objv[1]), Tcl_DStringValue(&args));
+    } else {
+	TkAQueueResult(id, "error", "no Android host");
+    }
+    Tcl_DStringFree(&args);
+    Tcl_SetObjResult(interp, Tcl_NewIntObj(id));
+    return TCL_OK;
+}
+
+/* ::tkdroid::permitted permission -> 1/0 (is the Android permission granted?) */
+static int
+PermittedCmd(void *cd, Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[])
+{
+    (void) cd;
+    if (objc != 2) {
+	Tcl_WrongNumArgs(interp, 1, objv, "permission");
+	return TCL_ERROR;
+    }
+    Tcl_SetObjResult(interp, Tcl_NewIntObj(tkAHost.checkPermission != NULL
+	    ? tkAHost.checkPermission(Tcl_GetString(objv[1])) : 0));
+    return TCL_OK;
+}
+
+/* ::tkdroid::a11ysend snapshot -- hand the accessibility snapshot to the host (see library/a11y.tcl). */
+static int
+A11ySendCmd(void *cd, Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[])
+{
+    (void) cd;
+    if (objc != 2) {
+	Tcl_WrongNumArgs(interp, 1, objv, "snapshot");
+	return TCL_ERROR;
+    }
+    if (tkAHost.a11yTree != NULL) {
+	tkAHost.a11yTree(Tcl_GetString(objv[1]));
+    }
+    return TCL_OK;
+}
+
+/* ::tkdroid::inputmode ?code|text|number|email|url|password?  -- what the soft keyboard offers. */
+static int
+InputModeCmd(void *cd, Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[])
+{
+    static const char *const modes[] = {"code", "text", "number", "email", "url", "password", NULL};
+    static int current;
+    int m;
+
+    (void) cd;
+    if (objc > 2) {
+	Tcl_WrongNumArgs(interp, 1, objv, "?code|text|number|email|url|password?");
+	return TCL_ERROR;
+    }
+    if (objc == 2) {
+	if (Tcl_GetIndexFromObj(interp, objv[1], modes, "mode", 0, &m) != TCL_OK) {
+	    return TCL_ERROR;
+	}
+	current = m;
+	if (tkAHost.inputMode != NULL) {
+	    tkAHost.inputMode(m);
+	}
+    }
+    Tcl_SetObjResult(interp, Tcl_NewStringObj(modes[current], TCL_AUTO_LENGTH));
+    return TCL_OK;
+}
+
+int
+TkAInitSystemCommands(Tcl_Interp *interp)
+{
+    Tcl_CreateObjCommand2(interp, "::tkdroid::inputmode", InputModeCmd, NULL, NULL);
+    Tcl_CreateObjCommand2(interp, "::tkdroid::a11ysend", A11ySendCmd, NULL, NULL);
+    Tcl_CreateObjCommand2(interp, "::tkdroid::request", RequestCmd, NULL, NULL);
+    Tcl_CreateObjCommand2(interp, "::tkdroid::permitted", PermittedCmd, NULL, NULL);
+    Tcl_CreateObjCommand2(interp, "::tkdroid::vibrate", VibrateCmd, NULL, NULL);
+    Tcl_CreateObjCommand2(interp, "::tkdroid::haptic", HapticCmd, NULL, NULL);
+    Tcl_CreateObjCommand2(interp, "::tkdroid::sound", SoundCmd, NULL, NULL);
+    Tcl_CreateObjCommand2(interp, "::tkdroid::device", InfoCmd, NULL, NULL);
+    return TCL_OK;
+}
diff --git a/android/tkAndroidTestEngine.c b/android/tkAndroidTestEngine.c
new file mode 100644
index 0000000..82d526d
--- /dev/null
+++ b/android/tkAndroidTestEngine.c
@@ -0,0 +1,219 @@
+/*
+ * tkAndroidTestEngine.c --
+ *
+ *	FreeType-based text engine used ONLY for host-side tests (it is not
+ *	compiled into Android builds, which use android.graphics.Paint). It makes
+ *	test screenshots look like real Tk text.
+ */
+
+#include "tkAndroidPriv.h"
+
+#ifdef TKA_TEST_FREETYPE
+#include <ft2build.h>
+#include FT_FREETYPE_H
+
+static FT_Library lib;
+
+typedef struct TFont { FT_Face face; int px; } TFont;
+
+static const char *
+PathFor(const char *family, int bold, int italic)
+{
+    int mono = family && (strstr(family, "mono") || strstr(family, "Courier") || strstr(family, "Mono"));
+    int serif = family && (strstr(family, "serif") && !strstr(family, "sans")) ;
+    static char path[256];
+    const char *dir = "/usr/share/fonts/truetype/dejavu/";
+    const char *base = mono ? "DejaVuSansMono" : serif ? "DejaVuSerif" : "DejaVuSans";
+
+    snprintf(path, sizeof(path), "%s%s%s%s.ttf", dir, base, bold ? "-Bold" : "",
+	    italic && !bold ? (mono ? "-Oblique" : "-Oblique") : "");
+    if (italic && !bold) {
+	/* DejaVuSans-Oblique.ttf exists; serif has no oblique */
+	if (serif) snprintf(path, sizeof(path), "%sDejaVuSerif.ttf", dir);
+    }
+    return path;
+}
+
+static void *
+Open(const char *family, int px, int bold, int italic, TkAFontInfo *info)
+{
+    TFont *f = (TFont *) calloc(1, sizeof(TFont));
+
+    if (lib == NULL && FT_Init_FreeType(&lib)) {
+	free(f);
+	return NULL;
+    }
+    /* The test fonts lack some styles (no sans oblique, no bold italic): fall back. */
+    if (FT_New_Face(lib, PathFor(family, bold, italic), 0, &f->face)
+	    && FT_New_Face(lib, PathFor(family, bold, 0), 0, &f->face)
+	    && FT_New_Face(lib, PathFor(family, 0, 0), 0, &f->face)
+	    && FT_New_Face(lib, PathFor(NULL, 0, 0), 0, &f->face)) {
+	free(f);
+	return NULL;
+    }
+    FT_Set_Pixel_Sizes(f->face, 0, (FT_UInt) px);
+    f->px = px;
+    info->ascent = (int) ((f->face->size->metrics.ascender + 63) >> 6);
+    info->descent = (int) ((-f->face->size->metrics.descender + 63) >> 6);
+    info->maxWidth = (int) ((f->face->size->metrics.max_advance + 63) >> 6);
+    info->fixed = FT_IS_FIXED_WIDTH(f->face) ? 1 : 0;
+    return f;
+}
+
+static void Close(void *font) { TFont *f = (TFont *) font; FT_Done_Face(f->face); free(f); }
+
+static int
+Measure(void *font, const char *s, int n)
+{
+    TFont *f = (TFont *) font;
+    int w = 0, i = 0;
+
+    while (i < n) {
+	int cp, len = (int) Tcl_UtfToUniChar(s + i, &cp);
+
+	if (len < 1) len = 1;
+	if (FT_Load_Char(f->face, (FT_ULong) cp, FT_LOAD_DEFAULT) == 0) {
+	    w += (int) ((f->face->glyph->advance.x + 32) >> 6);
+	}
+	i += len;
+    }
+    return w;
+}
+
+static uint8_t *
+Render(void *font, const char *s, int n, int *ow, int *oh, int *base)
+{
+    TFont *f = (TFont *) font;
+    int asc = (int) ((f->face->size->metrics.ascender + 63) >> 6);
+    int desc = (int) ((-f->face->size->metrics.descender + 63) >> 6);
+    int total = Measure(font, s, n) + 4, h = asc + desc, pen = 0, i = 0;
+    uint8_t *m;
+
+    if (total <= 4 || h <= 0) {
+	return NULL;
+    }
+    m = (uint8_t *) calloc((size_t) total * (size_t) h, 1);
+    while (i < n) {
+	int cp, len = (int) Tcl_UtfToUniChar(s + i, &cp), r, c;
+	FT_GlyphSlot g;
+
+	if (len < 1) len = 1;
+	if (FT_Load_Char(f->face, (FT_ULong) cp, FT_LOAD_RENDER) == 0) {
+	    g = f->face->glyph;
+	    for (r = 0; r < (int) g->bitmap.rows; r++) {
+		int y = asc - g->bitmap_top + r;
+
+		for (c = 0; c < (int) g->bitmap.width; c++) {
+		    int x = pen + g->bitmap_left + c;
+
+		    if (x >= 0 && x < total && y >= 0 && y < h) {
+			int a = g->bitmap.buffer[r * g->bitmap.pitch + c] + m[y * total + x];
+
+			m[y * total + x] = (uint8_t) (a > 255 ? 255 : a);
+		    }
+		}
+	    }
+	    pen += (int) ((g->advance.x + 32) >> 6);
+	}
+	i += len;
+    }
+    *ow = total;
+    *oh = h;
+    *base = asc;
+    return m;
+}
+
+static void
+Families(void (*add)(void *, const char *), void *ctx)
+{
+    add(ctx, "sans-serif");
+    add(ctx, "serif");
+    add(ctx, "monospace");
+}
+
+static const TkATextEngine engine = {Open, Close, Measure, Render, Families};
+const TkATextEngine *TkAGetBuiltinEngine(void) { return &engine; }
+
+#else
+/*
+ * Fallback for builds without FreeType (the Android libraries): glyphs are drawn
+ * as hollow boxes. The Android app installs a real engine (android.graphics.Paint)
+ * before Tk starts; this exists so Tk can run, and be tested, without one
+ * (for example under Bionic in a chroot).
+ */
+typedef struct BoxFont { int px; } BoxFont;
+
+static void *
+BoxOpen(const char *family, int px, int bold, int italic, TkAFontInfo *info)
+{
+    BoxFont *f = (BoxFont *) calloc(1, sizeof(BoxFont));
+
+    (void) family; (void) bold; (void) italic;
+    f->px = px;
+    info->ascent = px * 4 / 5;
+    info->descent = px - info->ascent;
+    info->maxWidth = px * 3 / 5;
+    info->fixed = 1;
+    return f;
+}
+
+static void BoxClose(void *font) { free(font); }
+
+static int
+BoxMeasure(void *font, const char *s, int n)
+{
+    int count = 0, i = 0, cp;
+
+    while (i < n) {
+	int len = (int) Tcl_UtfToUniChar(s + i, &cp);
+
+	i += len < 1 ? 1 : len;
+	count++;
+    }
+    return count * ((BoxFont *) font)->px * 3 / 5;
+}
+
+static uint8_t *
+BoxRender(void *font, const char *s, int n, int *ow, int *oh, int *base)
+{
+    BoxFont *f = (BoxFont *) font;
+    int adv = f->px * 3 / 5, asc = f->px * 4 / 5, w = BoxMeasure(font, s, n), h = f->px;
+    uint8_t *m;
+    int i = 0, k = 0, x, y, cp;
+
+    if (w <= 0) {
+	return NULL;
+    }
+    m = (uint8_t *) calloc((size_t) w * (size_t) h, 1);
+    while (i < n) {
+	int len = (int) Tcl_UtfToUniChar(s + i, &cp);
+
+	i += len < 1 ? 1 : len;
+	if (cp != ' ') {
+	    for (y = asc / 3; y < asc; y++) {
+		for (x = 1; x < adv - 1; x++) {
+		    int edge = (y == asc / 3 || y == asc - 1 || x == 1 || x == adv - 2);
+
+		    if (edge) m[y * w + k * adv + x] = 255;
+		}
+	    }
+	}
+	k++;
+    }
+    *ow = w;
+    *oh = h;
+    *base = asc;
+    return m;
+}
+
+static void
+BoxFamilies(void (*add)(void *, const char *), void *ctx)
+{
+    add(ctx, "sans-serif");
+    add(ctx, "serif");
+    add(ctx, "monospace");
+}
+
+static const TkATextEngine boxEngine = {BoxOpen, BoxClose, BoxMeasure, BoxRender, BoxFamilies};
+const TkATextEngine *TkAGetBuiltinEngine(void) { return &boxEngine; }
+#endif
diff --git a/android/tkAndroidWindow.c b/android/tkAndroidWindow.c
new file mode 100644
index 0000000..1c7bd6a
--- /dev/null
+++ b/android/tkAndroidWindow.c
@@ -0,0 +1,907 @@
+/*
+ * tkAndroidWindow.c --
+ *
+ *	The in-process "X server": window tree, geometry, stacking, mapping,
+ *	pixmaps and visibility/clipping. There is no X connection; windows are
+ *	TkADrawable records and all of them paint into the root's single pixel
+ *	buffer. Where Tk relies on X semantics, those are reproduced here:
+ *	a window's background is painted before it is exposed, and exposing a
+ *	window exposes what it uncovers in its parent.
+ */
+
+#include "tkAndroidPriv.h"
+
+/* From tkAndroidDraw.c */
+void TkAFillClipped(const TkARegion *clip, TkARect r, uint32_t pixel);
+void TkACopyRoot(const TkARegion *clip, TkARect dst, int srcX, int srcY);
+
+/*
+ * ---------------------------------------------------------------------------
+ * Tree helpers
+ * ---------------------------------------------------------------------------
+ */
+
+void
+TkAWindowOrigin(TkADrawable *d, int *xp, int *yp)
+{
+    int x = 0, y = 0;
+
+    for (; d != NULL && d->isWindow; d = d->parent) {
+	x += d->x;
+	y += d->y;
+    }
+    *xp = x;
+    *yp = y;
+}
+
+int
+TkAIsViewable(TkADrawable *d)
+{
+    for (; d != NULL; d = d->parent) {
+	if (d != tkA.root && !d->mapped) {
+	    return 0;
+	}
+    }
+    return 1;
+}
+
+static void
+Unlink(TkADrawable *d)
+{
+    TkADrawable *p = d->parent;
+
+    if (p == NULL) {
+	return;
+    }
+    if (d->prev) d->prev->next = d->next; else p->first = d->next;
+    if (d->next) d->next->prev = d->prev; else p->last = d->prev;
+    d->prev = d->next = NULL;
+}
+
+static void
+LinkTop(TkADrawable *d, TkADrawable *p)
+{
+    d->parent = p;
+    d->prev = p->last;
+    d->next = NULL;
+    if (p->last) p->last->next = d; else p->first = d;
+    p->last = d;
+}
+
+/* Insert d directly above (above!=0) or below `sib` (a sibling). */
+static void
+LinkRelative(TkADrawable *d, TkADrawable *sib, int above)
+{
+    TkADrawable *p = sib->parent;
+
+    d->parent = p;
+    if (above) {
+	d->prev = sib;
+	d->next = sib->next;
+	if (sib->next) sib->next->prev = d; else p->last = d;
+	sib->next = d;
+    } else {
+	d->next = sib;
+	d->prev = sib->prev;
+	if (sib->prev) sib->prev->next = d; else p->first = d;
+	sib->prev = d;
+    }
+}
+
+static TkARect
+RectOf(TkADrawable *d)
+{
+    TkARect r;
+    int x, y;
+
+    TkAWindowOrigin(d, &x, &y);
+    r.x1 = x;
+    r.y1 = y;
+    r.x2 = x + d->w;
+    r.y2 = y + d->h;
+    return r;
+}
+
+/*
+ * The visible part of a window, in root coordinates: its rectangle, clipped by
+ * every ancestor, minus mapped children, minus higher-stacked siblings of the
+ * window and of each ancestor (which may overlap it).
+ */
+void
+TkAComputeClip(TkADrawable *d, TkARegion *clip)
+{
+    TkADrawable *a, *s, *c;
+
+    TkARegionClear(clip);
+    if (d == NULL || !TkAIsViewable(d)) {
+	return;
+    }
+    TkARegionAddRect(clip, RectOf(d));
+    for (a = d; a != NULL && a->parent != NULL; a = a->parent) {
+	TkARegionIntersectRect(clip, RectOf(a->parent));
+	for (s = a->next; s != NULL; s = s->next) {
+	    if (s->mapped) {
+		TkARegionSubtractRect(clip, RectOf(s));
+	    }
+	}
+    }
+    for (c = d->first; c != NULL; c = c->next) {
+	if (c->mapped) {
+	    TkARegionSubtractRect(clip, RectOf(c));
+	}
+    }
+}
+
+TkADrawable *
+TkAWindowAt(int x, int y)
+{
+    TkADrawable *d = tkA.root, *c;
+    int again = 1;
+
+    while (again) {
+	again = 0;
+	for (c = d->last; c != NULL; c = c->prev) {
+	    TkARect r = RectOf(c);
+
+	    if (c->mapped && x >= r.x1 && x < r.x2 && y >= r.y1 && y < r.y2) {
+		d = c;
+		again = 1;
+		break;
+	    }
+	}
+    }
+    return d;
+}
+
+/* ---- the set of live drawables (see TKA_DRAWABLE) ---- */
+
+static uintptr_t *liveTab;
+static size_t liveCap, liveCount, liveUsed;	/* used = live + tombstones */
+#define TOMB ((uintptr_t) 1)
+
+static size_t
+LiveHash(uintptr_t p)
+{
+    return (size_t) ((p >> 4) * 11400714819323198485ull >> 20);
+}
+
+static void
+LiveGrow(void)
+{
+    uintptr_t *old = liveTab;
+    size_t oldCap = liveCap, i;
+
+    liveCap = liveCap ? liveCap * 2 : 1024;
+    liveTab = (uintptr_t *) calloc(liveCap, sizeof(uintptr_t));
+    liveCount = liveUsed = 0;
+    for (i = 0; i < oldCap; i++) {
+	if (old[i] > TOMB) {
+	    TkADrawableRegister((TkADrawable *) old[i]);
+	}
+    }
+    free(old);
+}
+
+void
+TkADrawableRegister(TkADrawable *d)
+{
+    size_t i;
+
+    if ((liveUsed + 1) * 2 > liveCap) {
+	LiveGrow();
+    }
+    for (i = LiveHash((uintptr_t) d) & (liveCap - 1); liveTab[i] > TOMB; i = (i + 1) & (liveCap - 1)) {
+	if (liveTab[i] == (uintptr_t) d) {
+	    return;
+	}
+    }
+    if (liveTab[i] == 0) {
+	liveUsed++;
+    }
+    liveTab[i] = (uintptr_t) d;
+    liveCount++;
+}
+
+void
+TkADrawableUnregister(TkADrawable *d)
+{
+    size_t i;
+
+    if (liveCap == 0) {
+	return;
+    }
+    for (i = LiveHash((uintptr_t) d) & (liveCap - 1); liveTab[i] != 0; i = (i + 1) & (liveCap - 1)) {
+	if (liveTab[i] == (uintptr_t) d) {
+	    liveTab[i] = TOMB;
+	    liveCount--;
+	    return;
+	}
+    }
+}
+
+TkADrawable *
+TkADrawableOf(uintptr_t id)
+{
+    size_t i;
+
+    if (id <= TOMB || liveCap == 0) {
+	return NULL;
+    }
+    for (i = LiveHash(id) & (liveCap - 1); liveTab[i] != 0; i = (i + 1) & (liveCap - 1)) {
+	if (liveTab[i] == id) {
+	    return (TkADrawable *) id;
+	}
+    }
+    return NULL;
+}
+
+/* Paint the window background over r (window coordinates) and mark it dirty. */
+static void
+PaintBackground(TkADrawable *d, TkARect r)
+{
+    TkARegion *clip;
+    int ox, oy;
+    TkARect rr;
+
+    if (!d->bgSet || !TkAIsViewable(d)) {
+	return;
+    }
+    clip = TkARegionNew();
+    TkAComputeClip(d, clip);
+    TkAWindowOrigin(d, &ox, &oy);
+    rr.x1 = r.x1 + ox;
+    rr.y1 = r.y1 + oy;
+    rr.x2 = r.x2 + ox;
+    rr.y2 = r.y2 + oy;
+    TkAFillClipped(clip, rr, (uint32_t) (d->bg & 0xFFFFFF) | TKA_OPAQUE);
+    TkARegionFree(clip);
+}
+
+/* X semantics: background painted, then an Expose event for the area. */
+static void
+ExposeWindow(TkADrawable *d, TkARect r)
+{
+    TkARect full = {0, 0, d->w, d->h};
+
+    if (r.x1 < 0) r.x1 = 0;
+    if (r.y1 < 0) r.y1 = 0;
+    if (r.x2 > full.x2) r.x2 = full.x2;
+    if (r.y2 > full.y2) r.y2 = full.y2;
+    if (r.x1 >= r.x2 || r.y1 >= r.y2 || !TkAIsViewable(d)) {
+	return;
+    }
+    PaintBackground(d, r);
+    if (d->winPtr != NULL) {
+	TkAGenerateExpose(d, r);
+    }
+}
+
+/* How much of the window shows: the X VisibilityNotify state. */
+static int
+VisibilityOf(TkADrawable *d)
+{
+    TkARegion *clip = TkARegionNew();
+    TkARect win;
+    long area = 0;
+    int i, ox, oy;
+
+    TkAComputeClip(d, clip);
+    TkAWindowOrigin(d, &ox, &oy);
+    win.x1 = ox; win.y1 = oy; win.x2 = ox + d->w; win.y2 = oy + d->h;
+    for (i = 0; i < clip->n; i++) {
+	TkARect r = clip->r[i];
+
+	if (r.x1 < win.x1) r.x1 = win.x1;
+	if (r.y1 < win.y1) r.y1 = win.y1;
+	if (r.x2 > win.x2) r.x2 = win.x2;
+	if (r.y2 > win.y2) r.y2 = win.y2;
+	if (r.x1 < r.x2 && r.y1 < r.y2) {
+	    area += (long) (r.x2 - r.x1) * (long) (r.y2 - r.y1);
+	}
+    }
+    TkARegionFree(clip);
+    return area == 0 ? VisibilityFullyObscured
+	    : area >= (long) d->w * (long) d->h ? VisibilityUnobscured : VisibilityPartiallyObscured;
+}
+
+static void
+ExposeTree(TkADrawable *d)
+{
+    TkADrawable *c;
+    TkARect full;
+
+    full.x1 = full.y1 = 0;
+    full.x2 = d->w;
+    full.y2 = d->h;
+    if (d->winPtr != NULL && (d->eventMask & VisibilityChangeMask) && TkAIsViewable(d)) {
+	TkAGenerateVisibility(d, VisibilityOf(d));	/* X sends this when a window is mapped */
+    }
+    ExposeWindow(d, full);
+    for (c = d->first; c != NULL; c = c->next) {
+	if (c->mapped) {
+	    ExposeTree(c);
+	}
+    }
+}
+
+/* Expose `area` (root coordinates) in every viewable window whose clip meets it. */
+static void
+ExposeRootArea(TkADrawable *d, TkARect area)
+{
+    TkADrawable *c;
+    int ox, oy;
+    TkARect r;
+
+    if (d != tkA.root && !d->mapped) {
+	return;
+    }
+    TkAWindowOrigin(d, &ox, &oy);
+    r.x1 = area.x1 - ox;
+    r.y1 = area.y1 - oy;
+    r.x2 = area.x2 - ox;
+    r.y2 = area.y2 - oy;
+    if (d != tkA.root) {
+	ExposeWindow(d, r);
+    }
+    for (c = d->first; c != NULL; c = c->next) {
+	ExposeRootArea(c, area);
+    }
+}
+
+/*
+ * ---------------------------------------------------------------------------
+ * Creation and destruction
+ * ---------------------------------------------------------------------------
+ */
+
+Window
+Tk_MakeWindow(Tk_Window tkwin, Window parent)
+{
+    TkWindow *winPtr = (TkWindow *) tkwin;
+    TkADrawable *d = (TkADrawable *) calloc(1, sizeof(TkADrawable));
+    TkADrawable *p = parent != None ? TKA_DRAWABLE(parent) : tkA.root;
+
+    d->isWindow = 1;
+    d->depth = winPtr->depth ? winPtr->depth : 24;
+    d->x = winPtr->changes.x;
+    d->y = winPtr->changes.y;
+    d->w = winPtr->changes.width > 0 ? winPtr->changes.width : 1;
+    d->h = winPtr->changes.height > 0 ? winPtr->changes.height : 1;
+    d->winPtr = winPtr;
+    TkADrawableRegister(d);
+    if (winPtr->dirtyAtts & CWBackPixel) {
+	d->bg = winPtr->atts.background_pixel;
+	d->bgSet = 1;
+    }
+    if (winPtr->dirtyAtts & CWEventMask) {
+	d->eventMask = winPtr->atts.event_mask;
+    }
+    LinkTop(d, p);
+    return TKA_ID(d);
+}
+
+void
+TkpMakeTransparentWindowExist(Tk_Window tkwin, Window parent)
+{
+    TkWindow *winPtr = (TkWindow *) tkwin;
+
+    winPtr->window = Tk_MakeWindow(tkwin, parent);
+}
+
+static void
+Destroy(TkADrawable *d)
+{
+    while (d->first != NULL) {
+	Destroy(d->first);
+    }
+    Unlink(d);
+    TkADrawableUnregister(d);
+    free(d->pix);
+    free(d);
+}
+
+/*
+ * An X server sends Enter/Leave to whatever is under the pointer when the window that was there
+ * disappears. Do the same: look again, once things have settled (idle), and let Tk's pointer module
+ * generate the crossing events.
+ */
+static int pointerRecheckQueued;
+
+static void
+PointerRecheck(void *cd)
+{
+    TkADrawable *d;
+    TkWindow *w = NULL;
+
+    (void) cd;
+    pointerRecheckQueued = 0;
+    if (tkA.ptrX < -1000 || tkA.root == NULL) {
+	return;			/* no pointer (cancelled touch) */
+    }
+    for (d = TkAWindowAt(tkA.ptrX, tkA.ptrY); w == NULL && d != NULL; d = d->parent) {
+	w = d->winPtr;
+    }
+    if (w != NULL) {
+	Tk_UpdatePointer((Tk_Window) w, tkA.ptrX, tkA.ptrY, tkA.ptrState);
+    }
+}
+
+static void
+QueuePointerRecheck(void)
+{
+    if (!pointerRecheckQueued) {
+	pointerRecheckQueued = 1;
+	Tcl_DoWhenIdle(PointerRecheck, NULL);
+    }
+}
+
+int
+XDestroyWindow(Display *display, Window w)
+{
+    TkADrawable *d = TKA_DRAWABLE(w), *p;
+    TkARect area;
+
+    (void) display;
+    if (d == NULL || d == tkA.root) {
+	return 0;
+    }
+    p = d->parent;
+    area = RectOf(d);
+    if (d->winPtr != NULL) {
+	QueuePointerRecheck();
+	/* Forget it in the pointer module (last-entered window, grab, capture), as the
+	 * Windows and macOS ports do, or the next touch would use a dead window. */
+	TkPointerDeadWindow(d->winPtr);
+    }
+    Destroy(d);
+    if (p != NULL) {
+	ExposeRootArea(p, area);
+    }
+    return 1;
+}
+
+Pixmap
+Tk_GetPixmap(Display *display, Drawable drawable, int width, int height, int depth)
+{
+    TkADrawable *d = (TkADrawable *) calloc(1, sizeof(TkADrawable));
+
+    (void) display;
+    (void) drawable;
+    d->depth = depth;
+    d->w = width > 0 ? width : 1;
+    d->h = height > 0 ? height : 1;
+    /* Like an X pixmap, contents start undefined: Tk paints a colour pixmap in full before it
+     * copies it, and skipping the clear saves megabytes of memset per widget redraw. Depth-1
+     * pixmaps (clip masks, stipples) must start clear: 0 means "not drawn". */
+    d->pix = depth == 1
+	    ? (uint32_t *) calloc((size_t) d->w * (size_t) d->h, sizeof(uint32_t))
+	    : (uint32_t *) malloc((size_t) d->w * (size_t) d->h * sizeof(uint32_t));
+    TkADrawableRegister(d);
+    return (Pixmap) TKA_ID(d);
+}
+
+void
+Tk_FreePixmap(Display *display, Pixmap pixmap)
+{
+    TkADrawable *d = TKA_DRAWABLE(pixmap);
+
+    (void) display;
+    if (d != NULL) {
+	TkADrawableUnregister(d);
+	free(d->pix);
+	free(d);
+    }
+}
+
+/*
+ * ---------------------------------------------------------------------------
+ * Mapping
+ * ---------------------------------------------------------------------------
+ */
+
+int
+XMapWindow(Display *display, Window w)
+{
+    TkADrawable *d = TKA_DRAWABLE(w);
+
+    (void) display;
+    if (d != NULL && !d->mapped) {
+	d->mapped = 1;
+	ExposeTree(d);
+    }
+    return 1;
+}
+
+int
+XUnmapWindow(Display *display, Window w)
+{
+    TkADrawable *d = TKA_DRAWABLE(w);
+
+    (void) display;
+    if (d != NULL && d->mapped) {
+	TkARect area = RectOf(d);
+
+	d->mapped = 0;
+	if (d->parent != NULL) {
+	    ExposeRootArea(d->parent, area);
+	}
+    }
+    return 1;
+}
+
+Status
+XIconifyWindow(Display *display, Window w, int screen)
+{
+    (void) screen;
+    return XUnmapWindow(display, w);
+}
+
+Status
+XWithdrawWindow(Display *display, Window w, int screen)
+{
+    (void) screen;
+    return XUnmapWindow(display, w);
+}
+
+/*
+ * ---------------------------------------------------------------------------
+ * Geometry and stacking
+ * ---------------------------------------------------------------------------
+ */
+
+static void
+Restack(TkADrawable *d, TkADrawable *sibling, int mode)
+{
+    TkADrawable *p = d->parent;
+
+    if (p == NULL) {
+	return;
+    }
+    if (sibling != NULL && sibling->parent != p) {
+	sibling = NULL;
+    }
+    Unlink(d);
+    switch (mode) {
+    case Above:
+	if (sibling != NULL) LinkRelative(d, sibling, 1); else LinkTop(d, p);
+	break;
+    case Below:
+	if (sibling != NULL) LinkRelative(d, sibling, 0);
+	else {
+	    /* lowest */
+	    d->parent = p;
+	    d->next = p->first;
+	    d->prev = NULL;
+	    if (p->first) p->first->prev = d; else p->last = d;
+	    p->first = d;
+	}
+	break;
+    default:
+	LinkTop(d, p);
+    }
+    if (TkAIsViewable(d)) {
+	/* Restacking changes what is visible: repaint this window and the rest of the level. */
+	ExposeRootArea(p, RectOf(d));
+    }
+}
+
+int
+XConfigureWindow(Display *display, Window w, unsigned int mask, XWindowChanges *c)
+{
+    TkADrawable *d = TKA_DRAWABLE(w);
+    TkARect before, after;
+    int resized = 0, moved = 0;
+
+    (void) display;
+    if (d == NULL || d == tkA.root) {
+	return 0;
+    }
+    before = RectOf(d);
+    if ((mask & CWX) && c->x != d->x) { d->x = c->x; moved = 1; }
+    if ((mask & CWY) && c->y != d->y) { d->y = c->y; moved = 1; }
+    if ((mask & CWWidth) && c->width > 0 && c->width != d->w) { d->w = c->width; resized = 1; }
+    if ((mask & CWHeight) && c->height > 0 && c->height != d->h) { d->h = c->height; resized = 1; }
+    if (mask & CWStackMode) {
+	Restack(d, (mask & CWSibling) ? TKA_DRAWABLE(c->sibling) : NULL, c->stack_mode);
+    }
+    after = RectOf(d);
+    if ((moved || resized) && TkAIsViewable(d)) {
+	/* What it vacated belongs to the parent (and siblings); what it now covers is new. */
+	if (d->parent != NULL) {
+	    ExposeRootArea(d->parent, before);
+	}
+	ExposeRootArea(d, after);
+	ExposeWindow(d, (TkARect) {0, 0, d->w, d->h});
+    }
+    return 1;
+}
+
+int
+XMoveWindow(Display *display, Window w, int x, int y)
+{
+    XWindowChanges c;
+
+    c.x = x;
+    c.y = y;
+    return XConfigureWindow(display, w, CWX | CWY, &c);
+}
+
+int
+XResizeWindow(Display *display, Window w, unsigned int width, unsigned int height)
+{
+    XWindowChanges c;
+
+    c.width = (int) width;
+    c.height = (int) height;
+    return XConfigureWindow(display, w, CWWidth | CWHeight, &c);
+}
+
+int
+XMoveResizeWindow(Display *display, Window w, int x, int y, unsigned int width,
+	unsigned int height)
+{
+    XWindowChanges c;
+
+    c.x = x;
+    c.y = y;
+    c.width = (int) width;
+    c.height = (int) height;
+    return XConfigureWindow(display, w, CWX | CWY | CWWidth | CWHeight, &c);
+}
+
+int
+XRaiseWindow(Display *display, Window w)
+{
+    XWindowChanges c;
+
+    c.stack_mode = Above;
+    return XConfigureWindow(display, w, CWStackMode, &c);
+}
+
+int
+XLowerWindow(Display *display, Window w)
+{
+    XWindowChanges c;
+
+    c.stack_mode = Below;
+    return XConfigureWindow(display, w, CWStackMode, &c);
+}
+
+/*
+ * ---------------------------------------------------------------------------
+ * Attributes
+ * ---------------------------------------------------------------------------
+ */
+
+int
+XChangeWindowAttributes(Display *display, Window w, unsigned long mask,
+	XSetWindowAttributes *a)
+{
+    TkADrawable *d = TKA_DRAWABLE(w);
+
+    (void) display;
+    if (d == NULL) {
+	return 0;
+    }
+    if (mask & CWBackPixel) {
+	d->bg = a->background_pixel;
+	d->bgSet = 1;
+    }
+    if (mask & CWEventMask) {
+	d->eventMask = a->event_mask;
+    }
+    return 1;
+}
+
+int
+XSetWindowBackground(Display *display, Window w, unsigned long pixel)
+{
+    XSetWindowAttributes a;
+
+    a.background_pixel = pixel;
+    return XChangeWindowAttributes(display, w, CWBackPixel, &a);
+}
+
+/* Background/border pixmaps, border width and colormaps are not supported. */
+int XSetWindowBackgroundPixmap(Display *d, Window w, Pixmap p) { (void) d; (void) w; (void) p; return 1; }
+int XSetWindowBorder(Display *d, Window w, unsigned long p) { (void) d; (void) w; (void) p; return 1; }
+int XSetWindowBorderPixmap(Display *d, Window w, Pixmap p) { (void) d; (void) w; (void) p; return 1; }
+int XSetWindowBorderWidth(Display *d, Window w, unsigned int b) { (void) d; (void) w; (void) b; return 1; }
+int XSetWindowColormap(Display *d, Window w, Colormap c) { (void) d; (void) w; (void) c; return 1; }
+
+int
+XSelectInput(Display *display, Window w, long mask)
+{
+    TkADrawable *d = TKA_DRAWABLE(w);
+
+    (void) display;
+    if (d != NULL) {
+	d->eventMask = mask;
+    }
+    return 1;
+}
+
+int
+XClearWindow(Display *display, Window w)
+{
+    TkADrawable *d = TKA_DRAWABLE(w);
+
+    (void) display;
+    if (d != NULL && d->isWindow) {
+	PaintBackground(d, (TkARect) {0, 0, d->w, d->h});
+    }
+    return 1;
+}
+
+Status
+XGetGeometry(Display *display, Drawable dr, Window *root, int *x, int *y,
+	unsigned int *width, unsigned int *height, unsigned int *border,
+	unsigned int *depth)
+{
+    TkADrawable *d = TKA_DRAWABLE(dr);
+
+    (void) display;
+    if (d == NULL) {
+	return 0;
+    }
+    if (root) *root = TKA_ID(tkA.root);
+    if (x) *x = d->isWindow ? d->x : 0;
+    if (y) *y = d->isWindow ? d->y : 0;
+    if (width) *width = (unsigned) d->w;
+    if (height) *height = (unsigned) d->h;
+    if (border) *border = 0;
+    if (depth) *depth = (unsigned) d->depth;
+    return 1;
+}
+
+Status
+XGetWindowAttributes(Display *display, Window w, XWindowAttributes *a)
+{
+    TkADrawable *d = TKA_DRAWABLE(w);
+
+    memset(a, 0, sizeof(*a));
+    if (d == NULL) {
+	return 0;
+    }
+    a->x = d->x;
+    a->y = d->y;
+    a->width = d->w;
+    a->height = d->h;
+    a->depth = d->depth;
+    a->root = TKA_ID(tkA.root);
+    a->screen = ScreenOfDisplay(display, 0);
+    a->visual = DefaultVisual(display, 0);
+    a->map_state = d->mapped ? IsViewable : IsUnmapped;
+    a->your_event_mask = d->eventMask;
+    a->override_redirect = 0;
+    return 1;
+}
+
+Window
+XRootWindow(Display *display, int screen)
+{
+    (void) display;
+    (void) screen;
+    return TKA_ID(tkA.root);
+}
+
+Status
+XQueryTree(Display *display, Window w, Window *root, Window *parent,
+	Window **children, unsigned int *n)
+{
+    TkADrawable *d = TKA_DRAWABLE(w), *c;
+    unsigned int count = 0, i = 0;
+
+    (void) display;
+    if (d == NULL) {
+	return 0;
+    }
+    for (c = d->first; c != NULL; c = c->next) count++;
+    *root = TKA_ID(tkA.root);
+    *parent = d->parent ? TKA_ID(d->parent) : None;
+    *children = count ? (Window *) ckalloc(count * sizeof(Window)) : NULL;   /* freed by Tk with XFree */
+    for (c = d->first; c != NULL; c = c->next) (*children)[i++] = TKA_ID(c);
+    *n = count;
+    return 1;
+}
+
+Bool
+XTranslateCoordinates(Display *display, Window src, Window dst, int sx, int sy,
+	int *dx, int *dy, Window *child)
+{
+    int ox = 0, oy = 0, px = 0, py = 0;
+
+    (void) display;
+    TkAWindowOrigin(TKA_DRAWABLE(src), &ox, &oy);
+    TkAWindowOrigin(TKA_DRAWABLE(dst), &px, &py);
+    *dx = sx + ox - px;
+    *dy = sy + oy - py;
+    if (child) *child = None;
+    return 1;
+}
+
+/*
+ * ---------------------------------------------------------------------------
+ * Tk-level geometry queries
+ * ---------------------------------------------------------------------------
+ */
+
+void
+Tk_GetRootCoords(Tk_Window tkwin, int *xp, int *yp)
+{
+    TkWindow *winPtr = (TkWindow *) tkwin;
+    int x = 0, y = 0;
+
+    if (winPtr->window != None) {
+	TkAWindowOrigin(TKA_DRAWABLE(winPtr->window), &x, &y);
+    } else {
+	for (; winPtr != NULL; winPtr = winPtr->parentPtr) {
+	    x += winPtr->changes.x;
+	    y += winPtr->changes.y;
+	    if (winPtr->flags & TK_TOP_HIERARCHY) {
+		break;
+	    }
+	}
+    }
+    *xp = x;
+    *yp = y;
+}
+
+Tk_Window
+Tk_CoordsToWindow(int rootX, int rootY, Tk_Window tkwin)
+{
+    TkADrawable *d = TkAWindowAt(rootX, rootY);
+    TkWindow *me = (TkWindow *) tkwin;
+
+    while (d != NULL && (d->winPtr == NULL || d->winPtr->mainPtr != me->mainPtr)) {
+	d = d->parent;
+    }
+    return d ? (Tk_Window) d->winPtr : NULL;
+}
+
+void
+Tk_GetVRootGeometry(Tk_Window tkwin, int *xp, int *yp, int *wp, int *hp)
+{
+    (void) tkwin;
+    *xp = 0;
+    *yp = 0;
+    *wp = tkA.width;
+    *hp = tkA.height;
+}
+
+int
+TkpScanWindowId(Tcl_Interp *interp, const char *string, Window *idPtr)
+{
+    unsigned long long v;
+    char *end;
+
+    v = strtoull(string, &end, 0);
+    if (end == string || *end != '\0' || v == 0) {
+	if (interp != NULL) {	/* callers may probe with no interpreter */
+	    Tcl_SetObjResult(interp, Tcl_ObjPrintf("expected integer but got \"%s\"", string));
+	}
+	return TCL_ERROR;
+    }
+    *idPtr = (Window) v;
+    return TCL_OK;
+}
+
+/*
+ * Scrolling: copy the rectangle and report what must be redrawn (damage).
+ */
+int
+TkScrollWindow(Tk_Window tkwin, GC gc, int x, int y, int width, int height,
+	int dx, int dy, TkRegion damageRgn)
+{
+    TkWindow *winPtr = (TkWindow *) tkwin;
+    TkARegion *damage = (TkARegion *) damageRgn;
+    TkARect rect = {x, y, x + width, y + height};
+    TkARect moved = {x + dx, y + dy, x + width + dx, y + height + dy};
+
+    XCopyArea(winPtr->display, winPtr->window, winPtr->window, gc, x, y,
+	    (unsigned) width, (unsigned) height, x + dx, y + dy);
+    TkARegionClear(damage);
+    TkARegionAddRect(damage, rect);
+    TkARegionSubtractRect(damage, moved);
+    return damage->n > 0;
+}
diff --git a/android/tkAndroidWm.c b/android/tkAndroidWm.c
new file mode 100644
index 0000000..345ddd3
--- /dev/null
+++ b/android/tkAndroidWm.c
@@ -0,0 +1,626 @@
+/*
+ * tkAndroidWm.c --
+ *
+ *	The window manager. Policy (docs/compatibility-policy.md):
+ *
+ *	  - "." (the application's main window) fills the screen;
+ *	  - every other toplevel is a *layer* inside the same surface, sized from
+ *	    its requested geometry, clamped to the screen, centred unless
+ *	    `wm geometry` positions it;
+ *	  - the Back button runs WM_DELETE_WINDOW of the topmost toplevel that has
+ *	    a handler, else asks the host to finish the Activity;
+ *	  - subcommands without an Android meaning are accepted: the value is
+ *	    stored and returned by queries, with no visible effect.
+ */
+
+#include "tkAndroidPriv.h"
+#include <stdio.h>
+
+typedef struct WmInfo {
+    TkWindow *winPtr;
+    struct WmInfo *nextPtr;
+    int withdrawn, neverMapped, iconic;
+    int hasPos, x, y;
+    int width, height;		/* from `wm geometry`; -1 = not set */
+    Tcl_Obj *title;
+    Tcl_HashTable protocols;	/* name -> Tcl_Obj command */
+    Tcl_HashTable misc;		/* accepted-only options: name -> Tcl_Obj */
+    TkWindow *transientFor;
+    int overrideRedirect;
+} WmInfo;
+
+static WmInfo *wmList;
+
+TkAHost tkAHost;
+
+void
+TkAndroidSetHost(const TkAHost *host)
+{
+    tkAHost = *host;
+}
+
+static int
+IsMain(WmInfo *w)
+{
+    return w->winPtr->mainPtr != NULL && w->winPtr == w->winPtr->mainPtr->winPtr;
+}
+
+/* ---- sizing --------------------------------------------------------------------------- */
+
+static void
+Apply(WmInfo *w)
+{
+    TkWindow *wp = w->winPtr;
+    int x, y, wd, ht;
+
+    /* TKDROID_DESKTOP_WM=1 (tests only): "." is sized like any toplevel instead of filling the
+     * screen, so Tk's own test suite, which assumes ordinary toplevels, measures widget logic. */
+    static int desktop = -1;
+
+    if (desktop < 0) {
+	const char *e = getenv("TKDROID_DESKTOP_WM");
+
+	desktop = e != NULL && e[0] == '1';
+    }
+    if (IsMain(w) && !desktop) {
+	x = y = 0;
+	wd = tkA.width;
+	ht = tkA.height;
+    } else {
+	wd = w->width > 0 ? w->width : Tk_ReqWidth(wp);
+	ht = w->height > 0 ? w->height : Tk_ReqHeight(wp);
+	if (wd < 1) wd = 1;
+	if (ht < 1) ht = 1;
+	if (wd > tkA.width) wd = tkA.width;
+	if (ht > tkA.height) ht = tkA.height;
+	x = w->hasPos ? w->x : (tkA.width - wd) / 2;
+	y = w->hasPos ? w->y : (tkA.height - ht) / 2;
+	if (x < 0) x = 0;
+	if (y < 0) y = 0;
+	if (x + wd > tkA.width) x = tkA.width - wd;
+	if (y + ht > tkA.height) y = tkA.height - ht;
+    }
+    if (wp->changes.x != x || wp->changes.y != y || wp->changes.width != wd
+	    || wp->changes.height != ht) {
+	Tk_MoveResizeWindow((Tk_Window) wp, x, y, wd, ht);
+    }
+}
+
+static void
+RequestProc(void *cd, Tk_Window tkwin)
+{
+    WmInfo *w = (WmInfo *) ((TkWindow *) tkwin)->wmInfoPtr;
+
+    (void) cd;
+    /* An unmapped (withdrawn, iconified, not yet shown) toplevel still takes its requested size, so
+     * that geometry managers inside it keep arranging their windows; mapping it later must not change
+     * what `winfo width` said meanwhile. */
+    if (w != NULL && w->winPtr->window != None) {
+	Apply(w);
+    }
+}
+
+static void
+LostSlaveProc(void *cd, Tk_Window tkwin)
+{
+    (void) cd;
+    (void) tkwin;
+}
+
+static const Tk_GeomMgr wmMgrType = {"wm", RequestProc, LostSlaveProc};
+
+void
+TkAWmScreenChanged(void)
+{
+    WmInfo *w;
+
+    for (w = wmList; w != NULL; w = w->nextPtr) {
+	if (w->winPtr->window != None) {
+	    Apply(w);
+	}
+    }
+}
+
+/* ---- lifecycle -------------------------------------------------------------------------- */
+
+void
+TkWmNewWindow(TkWindow *winPtr)
+{
+    WmInfo *w = (WmInfo *) calloc(1, sizeof(WmInfo));
+
+    w->winPtr = winPtr;
+    w->neverMapped = 1;
+    w->width = w->height = -1;
+    Tcl_InitHashTable(&w->protocols, TCL_STRING_KEYS);
+    Tcl_InitHashTable(&w->misc, TCL_STRING_KEYS);
+    w->nextPtr = wmList;
+    wmList = w;
+    winPtr->wmInfoPtr = (struct TkWmInfo *) w;
+    Tk_ManageGeometry((Tk_Window) winPtr, &wmMgrType, NULL);
+}
+
+void
+TkWmDeadWindow(TkWindow *winPtr)
+{
+    WmInfo *w = (WmInfo *) winPtr->wmInfoPtr, **pp;
+    Tcl_HashSearch s;
+    Tcl_HashEntry *e;
+
+    if (w == NULL) {
+	return;
+    }
+    for (pp = &wmList; *pp != NULL; pp = &(*pp)->nextPtr) {
+	if (*pp == w) {
+	    *pp = w->nextPtr;
+	    break;
+	}
+    }
+    for (e = Tcl_FirstHashEntry(&w->protocols, &s); e != NULL; e = Tcl_NextHashEntry(&s)) {
+	Tcl_DecrRefCount((Tcl_Obj *) Tcl_GetHashValue(e));
+    }
+    for (e = Tcl_FirstHashEntry(&w->misc, &s); e != NULL; e = Tcl_NextHashEntry(&s)) {
+	Tcl_DecrRefCount((Tcl_Obj *) Tcl_GetHashValue(e));
+    }
+    Tcl_DeleteHashTable(&w->protocols);
+    Tcl_DeleteHashTable(&w->misc);
+    if (w->title) Tcl_DecrRefCount(w->title);
+    TkAFocusLost(winPtr);
+    free(w);
+    winPtr->wmInfoPtr = NULL;
+}
+
+static void
+SendEvent(TkWindow *winPtr, int type)
+{
+    XEvent ev;
+
+    memset(&ev, 0, sizeof(ev));
+    ev.type = type;
+    ev.xmap.serial = TkANextSerial();
+    ev.xmap.display = winPtr->display;
+    ev.xmap.event = winPtr->window;
+    ev.xmap.window = winPtr->window;
+    Tk_HandleEvent(&ev);
+}
+
+void
+TkWmMapWindow(TkWindow *winPtr)
+{
+    WmInfo *w = (WmInfo *) winPtr->wmInfoPtr;
+
+    if (w->withdrawn) {
+	return;
+    }
+    w->neverMapped = 0;
+    w->iconic = 0;
+    Apply(w);
+    winPtr->flags |= TK_MAPPED;
+    XMapWindow(winPtr->display, winPtr->window);
+    SendEvent(winPtr, MapNotify);
+    if (TkAActiveTop() == NULL || !IsMain(w)) {
+	TkpChangeFocus(winPtr, 0);
+    }
+}
+
+void
+TkWmUnmapWindow(TkWindow *winPtr)
+{
+    if (!(winPtr->flags & TK_MAPPED)) {
+	return;
+    }
+    winPtr->flags &= ~TK_MAPPED;
+    XUnmapWindow(winPtr->display, winPtr->window);
+    SendEvent(winPtr, UnmapNotify);
+}
+
+int
+TkpWmSetState(TkWindow *winPtr, int state)
+{
+    WmInfo *w = (WmInfo *) winPtr->wmInfoPtr;
+
+    if (state == WithdrawnState) {
+	w->withdrawn = 1;
+	TkWmUnmapWindow(winPtr);
+    } else if (state == IconicState) {
+	w->iconic = 1;
+	TkWmUnmapWindow(winPtr);
+	if (IsMain(w) && tkAHost.moveToBack) {
+	    tkAHost.moveToBack();
+	}
+    } else {
+	w->withdrawn = 0;
+	w->iconic = 0;
+	Tk_MapWindow((Tk_Window) winPtr);
+    }
+    return 1;
+}
+
+void TkWmSetClass(TkWindow *winPtr) { (void) winPtr; }
+int XSetIconName(Display *d, Window w, const char *name) { (void) d; (void) w; (void) name; return 1; }
+void TkWmProtocolEventProc(TkWindow *winPtr, XEvent *ev) { (void) winPtr; (void) ev; }
+void TkWmCleanup(TkDisplay *dispPtr) { (void) dispPtr; }
+void Tk_SetGrid(Tk_Window tkwin, int rw, int rh, int gw, int gh) { (void) tkwin; (void) rw; (void) rh; (void) gw; (void) gh; }
+void Tk_UnsetGrid(Tk_Window tkwin) { (void) tkwin; }
+void TkUnixSetMenubar(Tk_Window tkwin, Tk_Window menubar) { (void) tkwin; (void) menubar; }
+void TkpMakeMenuWindow(Tk_Window tkwin, int transient) { (void) tkwin; (void) transient; }
+
+void
+Tk_MoveToplevelWindow(Tk_Window tkwin, int x, int y)
+{
+    WmInfo *w = ((TkWindow *) tkwin)->wmInfoPtr ? (WmInfo *) ((TkWindow *) tkwin)->wmInfoPtr : NULL;
+
+    if (w != NULL) {
+	w->hasPos = 1;
+	w->x = x;
+	w->y = y;
+	if (w->winPtr->flags & TK_MAPPED) {
+	    Apply(w);
+	}
+    }
+}
+
+void
+TkWmRestackToplevel(TkWindow *winPtr, int aboveBelow, TkWindow *otherPtr)
+{
+    XWindowChanges c;
+    unsigned mask = CWStackMode;
+
+    c.stack_mode = aboveBelow;
+    if (otherPtr != NULL && otherPtr->window != None) {
+	c.sibling = otherPtr->window;
+	mask |= CWSibling;
+    }
+    XConfigureWindow(winPtr->display, winPtr->window, mask, &c);
+}
+
+TkWindow **
+TkWmStackorderToplevel(TkWindow *parentPtr)
+{
+    TkADrawable *c;
+    int n = 0;
+    TkWindow **list;
+
+    for (c = tkA.root->first; c != NULL; c = c->next) {
+	if (c->winPtr != NULL && c->winPtr->mainPtr == parentPtr->mainPtr) n++;
+    }
+    list = (TkWindow **) ckalloc((size_t) (n + 1) * sizeof(TkWindow *));
+    n = 0;
+    for (c = tkA.root->first; c != NULL; c = c->next) {
+	if (c->winPtr != NULL && c->winPtr->mainPtr == parentPtr->mainPtr) list[n++] = c->winPtr;
+    }
+    list[n] = NULL;
+    return list;
+}
+
+/* ---- Back navigation ---------------------------------------------------------------------------- */
+
+static void
+RunProtocol(WmInfo *w, Tcl_Obj *cmd)
+{
+    Tcl_Interp *interp = w->winPtr->mainPtr->interp;
+
+    Tcl_Preserve(interp);
+    Tcl_IncrRefCount(cmd);
+    if (Tcl_EvalObjEx(interp, cmd, TCL_EVAL_GLOBAL) != TCL_OK) {
+	Tcl_BackgroundException(interp, TCL_ERROR);
+    }
+    Tcl_DecrRefCount(cmd);
+    Tcl_Release(interp);
+}
+
+void
+TkAHandleBack(void)
+{
+    TkADrawable *c;
+
+    /* topmost mapped toplevel first */
+    for (c = tkA.root->last; c != NULL; c = c->prev) {
+	WmInfo *w;
+	Tcl_HashEntry *e;
+
+	if (c->winPtr == NULL || !c->mapped) {
+	    continue;
+	}
+	w = (WmInfo *) c->winPtr->wmInfoPtr;
+	if (w == NULL) {
+	    continue;
+	}
+	e = Tcl_FindHashEntry(&w->protocols, "WM_DELETE_WINDOW");
+	if (e != NULL) {
+	    RunProtocol(w, (Tcl_Obj *) Tcl_GetHashValue(e));
+	    return;
+	}
+	if (!IsMain(w)) {
+	    /* a layer without a handler: just dismiss it */
+	    TkpWmSetState(w->winPtr, WithdrawnState);
+	    return;
+	}
+    }
+    if (tkAHost.backUnhandled) {
+	tkAHost.backUnhandled();
+    }
+}
+
+/* ---- the `wm` command -------------------------------------------------------------------------- */
+
+static Tcl_Obj *
+MiscGet(WmInfo *w, const char *key, const char *dflt)
+{
+    Tcl_HashEntry *e = Tcl_FindHashEntry(&w->misc, key);
+
+    return e ? (Tcl_Obj *) Tcl_GetHashValue(e) : Tcl_NewStringObj(dflt, TCL_AUTO_LENGTH);
+}
+
+static void
+MiscSet(WmInfo *w, const char *key, Tcl_Obj *val)
+{
+    int isNew;
+    Tcl_HashEntry *e = Tcl_CreateHashEntry(&w->misc, key, &isNew);
+
+    if (!isNew) {
+	Tcl_DecrRefCount((Tcl_Obj *) Tcl_GetHashValue(e));
+    }
+    Tcl_IncrRefCount(val);
+    Tcl_SetHashValue(e, val);
+}
+
+static int
+ParseGeometry(const char *s, int *w, int *h, int *x, int *y, int *hasPos)
+{
+    int a, b, c, d;
+    char sx, sy;
+
+    *w = *h = -1;
+    *hasPos = 0;
+    if (*s == '=') s++;
+    if (sscanf(s, "%dx%d%c%d%c%d", &a, &b, &sx, &c, &sy, &d) == 6) {
+	*w = a; *h = b; *x = sx == '-' ? tkA.width - a - c : c; *y = sy == '-' ? tkA.height - b - d : d;
+	*hasPos = 1;
+	return 1;
+    }
+    if (sscanf(s, "%dx%d", &a, &b) == 2) {
+	*w = a; *h = b;
+	return 1;
+    }
+    if (sscanf(s, "%c%d%c%d", &sx, &c, &sy, &d) == 4 && (sx == '+' || sx == '-')) {
+	*x = sx == '-' ? -c : c; *y = sy == '-' ? -d : d;
+	*hasPos = 1;
+	return 1;
+    }
+    return 0;
+}
+
+int
+Tk_WmObjCmd(void *clientData, Tcl_Interp *interp, int objc, Tcl_Obj *const objv[])
+{
+    static const char *const subs[] = {
+	"aspect", "attributes", "client", "colormapwindows", "command", "deiconify",
+	"focusmodel", "forget", "frame", "geometry", "grid", "group", "iconbadge",
+	"iconbitmap", "iconify", "iconmask", "iconname", "iconphoto", "iconposition",
+	"iconwindow", "manage", "maxsize", "minsize", "overrideredirect", "positionfrom",
+	"protocol", "resizable", "sizefrom", "stackorder", "state", "title", "transient",
+	"withdraw", NULL
+    };
+    enum { AspectI, AttributesI, ClientI, ColormapwindowsI, CommandI, DeiconifyI,
+	FocusmodelI, ForgetI, FrameI, GeometryI, GridI, GroupI, IconbadgeI,
+	IconbitmapI, IconifyI, IconmaskI, IconnameI, IconphotoI, IconpositionI,
+	IconwindowI, ManageI, MaxsizeI, MinsizeI, OverrideredirectI, PositionfromI,
+	ProtocolI, ResizableI, SizefromI, StackorderI, StateI, TitleI, TransientI,
+	WithdrawI };
+    Tk_Window main = (Tk_Window) clientData, tkwin;
+    TkWindow *winPtr;
+    WmInfo *w;
+    int idx;
+
+    if (objc < 2) {
+	Tcl_WrongNumArgs(interp, 1, objv, "option window ?arg ...?");
+	return TCL_ERROR;
+    }
+    if (Tcl_GetIndexFromObj(interp, objv[1], subs, "option", 0, &idx) != TCL_OK) {
+	return TCL_ERROR;
+    }
+    if (objc < 3) {
+	Tcl_WrongNumArgs(interp, 2, objv, "window ?arg ...?");
+	return TCL_ERROR;
+    }
+    if (idx == ManageI || idx == ForgetI) {
+	Tcl_SetObjResult(interp, Tcl_ObjPrintf("wm %s is not yet supported on Android", subs[idx]));
+	return TCL_ERROR;
+    }
+    tkwin = Tk_NameToWindow(interp, Tcl_GetString(objv[2]), main);
+    if (tkwin == NULL) {
+	return TCL_ERROR;
+    }
+    winPtr = (TkWindow *) tkwin;
+    if (!(winPtr->flags & TK_TOP_HIERARCHY) || winPtr->wmInfoPtr == NULL) {
+	Tcl_SetObjResult(interp, Tcl_ObjPrintf("window \"%s\" isn't a top-level window",
+		Tcl_GetString(objv[2])));
+	return TCL_ERROR;
+    }
+    w = (WmInfo *) winPtr->wmInfoPtr;
+
+    switch (idx) {
+    case TitleI:
+	if (objc == 4) {
+	    if (w->title) Tcl_DecrRefCount(w->title);
+	    w->title = objv[3];
+	    Tcl_IncrRefCount(w->title);
+	    if (IsMain(w) && tkAHost.setTitle) tkAHost.setTitle(Tcl_GetString(w->title));
+	} else if (objc != 3) {
+	    Tcl_WrongNumArgs(interp, 2, objv, "window ?newTitle?");
+	    return TCL_ERROR;
+	}
+	Tcl_SetObjResult(interp, w->title ? w->title : Tcl_NewStringObj(winPtr->nameUid, TCL_AUTO_LENGTH));
+	return TCL_OK;
+
+    case GeometryI:
+	if (objc == 4) {
+	    const char *s = Tcl_GetString(objv[3]);
+	    int gw, gh, gx = 0, gy = 0, hp;
+
+	    if (s[0] == '\0') {
+		w->width = w->height = -1;
+		w->hasPos = 0;
+	    } else if (!ParseGeometry(s, &gw, &gh, &gx, &gy, &hp)) {
+		Tcl_SetObjResult(interp, Tcl_ObjPrintf("bad geometry specifier \"%s\"", s));
+		return TCL_ERROR;
+	    } else {
+		if (gw > 0) { w->width = gw; w->height = gh; }
+		if (hp) { w->hasPos = 1; w->x = gx; w->y = gy; }
+	    }
+	    if (winPtr->flags & TK_MAPPED) Apply(w);
+	    return TCL_OK;
+	}
+	Tcl_SetObjResult(interp, Tcl_ObjPrintf("%dx%d+%d+%d", Tk_Width(tkwin), Tk_Height(tkwin),
+		winPtr->changes.x, winPtr->changes.y));
+	return TCL_OK;
+
+    case StateI:
+	if (objc == 4) {
+	    static const char *const st[] = {"normal", "iconic", "withdrawn", "zoomed", NULL};
+	    int s;
+
+	    if (Tcl_GetIndexFromObj(interp, objv[3], st, "argument", 0, &s) != TCL_OK) return TCL_ERROR;
+	    TkpWmSetState(winPtr, s == 1 ? IconicState : s == 2 ? WithdrawnState : NormalState);
+	    return TCL_OK;
+	}
+	Tcl_SetObjResult(interp, Tcl_NewStringObj(w->withdrawn ? "withdrawn" : w->iconic ? "iconic" : "normal", TCL_AUTO_LENGTH));
+	return TCL_OK;
+
+    case WithdrawI:
+	TkpWmSetState(winPtr, WithdrawnState);
+	return TCL_OK;
+    case DeiconifyI:
+	TkpWmSetState(winPtr, NormalState);
+	return TCL_OK;
+    case IconifyI:
+	TkpWmSetState(winPtr, IconicState);
+	return TCL_OK;
+
+    case ProtocolI: {
+	Tcl_HashEntry *e;
+
+	if (objc == 3) {
+	    Tcl_Obj *list = Tcl_NewObj();
+	    Tcl_HashSearch s;
+
+	    for (e = Tcl_FirstHashEntry(&w->protocols, &s); e; e = Tcl_NextHashEntry(&s)) {
+		Tcl_ListObjAppendElement(NULL, list, Tcl_NewStringObj(Tcl_GetHashKey(&w->protocols, e), TCL_AUTO_LENGTH));
+	    }
+	    Tcl_SetObjResult(interp, list);
+	    return TCL_OK;
+	}
+	e = Tcl_FindHashEntry(&w->protocols, Tcl_GetString(objv[3]));
+	if (objc == 4) {
+	    if (e) Tcl_SetObjResult(interp, (Tcl_Obj *) Tcl_GetHashValue(e));
+	    return TCL_OK;
+	}
+	if (e) {
+	    Tcl_DecrRefCount((Tcl_Obj *) Tcl_GetHashValue(e));
+	    Tcl_DeleteHashEntry(e);
+	}
+	if (Tcl_GetCharLength(objv[4]) > 0) {
+	    int isNew;
+
+	    e = Tcl_CreateHashEntry(&w->protocols, Tcl_GetString(objv[3]), &isNew);
+	    Tcl_IncrRefCount(objv[4]);
+	    Tcl_SetHashValue(e, objv[4]);
+	}
+	return TCL_OK;
+    }
+
+    case TransientI:
+	if (objc == 4) {
+	    if (Tcl_GetCharLength(objv[3]) == 0) {
+		w->transientFor = NULL;
+	    } else {
+		Tk_Window m = Tk_NameToWindow(interp, Tcl_GetString(objv[3]), main);
+
+		if (m == NULL) return TCL_ERROR;
+		w->transientFor = (TkWindow *) m;
+	    }
+	    return TCL_OK;
+	}
+	Tcl_SetObjResult(interp, Tcl_NewStringObj(w->transientFor ? w->transientFor->pathName : "", TCL_AUTO_LENGTH));
+	return TCL_OK;
+
+    case OverrideredirectI:
+	if (objc == 4) {
+	    int b;
+
+	    if (Tcl_GetBooleanFromObj(interp, objv[3], &b) != TCL_OK) return TCL_ERROR;
+	    w->overrideRedirect = b;
+	    Tk_ChangeWindowAttributes(tkwin, CWOverrideRedirect, &(XSetWindowAttributes) {.override_redirect = b});
+	    return TCL_OK;
+	}
+	Tcl_SetObjResult(interp, Tcl_NewBooleanObj(w->overrideRedirect));
+	return TCL_OK;
+
+    case FrameI:
+	Tcl_SetObjResult(interp, Tcl_ObjPrintf("0x%lx", (unsigned long) winPtr->window));
+	return TCL_OK;
+
+    case StackorderI: {
+	TkWindow **order = TkWmStackorderToplevel(winPtr), **p;
+	Tcl_Obj *list = Tcl_NewObj();
+
+	for (p = order; *p != NULL; p++) {
+	    Tcl_ListObjAppendElement(NULL, list, Tcl_NewStringObj((*p)->pathName, TCL_AUTO_LENGTH));
+	}
+	ckfree(order);
+	Tcl_SetObjResult(interp, list);
+	return TCL_OK;
+    }
+
+    case AttributesI: {
+	static const char *const known[] = {"-alpha", "-fullscreen", "-topmost", "-type", "-zoomed", NULL};
+	static const char *const dflt[] = {"1.0", "0", "0", "", "0"};
+	int i;
+
+	if (objc == 3) {
+	    Tcl_Obj *list = Tcl_NewObj();
+
+	    for (i = 0; known[i]; i++) {
+		Tcl_ListObjAppendElement(NULL, list, Tcl_NewStringObj(known[i], TCL_AUTO_LENGTH));
+		Tcl_ListObjAppendElement(NULL, list, MiscGet(w, known[i], dflt[i]));
+	    }
+	    Tcl_SetObjResult(interp, list);
+	    return TCL_OK;
+	}
+	if (Tcl_GetIndexFromObj(interp, objv[3], known, "attribute", 0, &i) != TCL_OK) return TCL_ERROR;
+	if (objc == 4) {
+	    Tcl_SetObjResult(interp, MiscGet(w, known[i], dflt[i]));
+	    return TCL_OK;
+	}
+	MiscSet(w, known[i], objv[4]);
+	if (i == 1 && IsMain(w) && tkAHost.setFullscreen) {
+	    int on;
+
+	    if (Tcl_GetBooleanFromObj(NULL, objv[4], &on) == TCL_OK) tkAHost.setFullscreen(on);
+	}
+	return TCL_OK;
+    }
+
+    default: {
+	/* Accepted: store what is set, return it (or a default) when queried. */
+	const char *name = subs[idx];
+	const char *dflt = "";
+
+	if (idx == FocusmodelI) dflt = "passive";
+	else if (idx == ResizableI) dflt = "1 1";
+	else if (idx == MinsizeI) dflt = "1 1";
+	else if (idx == MaxsizeI) dflt = "";
+	if (objc == 3) {
+	    Tcl_SetObjResult(interp, MiscGet(w, name, dflt));
+	    return TCL_OK;
+	}
+	if (idx == MaxsizeI && objc == 3) {
+	    Tcl_SetObjResult(interp, Tcl_ObjPrintf("%d %d", tkA.width, tkA.height));
+	    return TCL_OK;
+	}
+	MiscSet(w, name, Tcl_NewListObj(objc - 3, objv + 3));
+	return TCL_OK;
+    }
+    }
+    return TCL_OK;
+}
diff --git a/library/a11y.tcl b/library/a11y.tcl
new file mode 100644
index 0000000..f246705
--- /dev/null
+++ b/library/a11y.tcl
@@ -0,0 +1,330 @@
+# a11y.tcl --
+#
+#	Accessibility for Tk on Android. Tk 9.0 has no accessibility API of its own, so this walks the
+#	widget tree and describes what a person using TalkBack (or another screen reader) needs: for every
+#	visible, meaningful widget its role, name, value, state, screen rectangle and what can be done to it.
+#	The description is a flat text snapshot sent to the Java side (AccessibilityNodeProvider), which turns
+#	it into Android accessibility nodes. Actions come back through ::tkdroid::native a11yaction.
+#
+#	Nothing runs unless a screen reader (or another accessibility service) is active.
+#
+#	Snapshot format, one node per line, tab separated:
+#	  id  parent  x1  y1  x2  y2  role  flags  text  value
+#	roles: button checkbox radio edit text list listitem slider progress window view
+#	flags: e enabled  f focused  c checkable  k checked  s selected  t editable text  x clickable
+#	       l scrollable  p password  m multi-line
+
+namespace eval ::tkdroid::a11y {
+    variable enabled 0
+    variable ids; array set ids {}		;# key (window path, or path#item) -> id
+    variable keys; array set keys {}		;# id -> key
+    variable nextId 1
+    variable seen {}				;# keys used by the snapshot being built
+    variable lines {}
+    variable last ""
+    variable lastFrames -1
+    variable job ""
+    variable maxText 400
+    variable override; array set override {}	;# window -> dict (name role hidden), set by ::tkdroid::accessible
+}
+
+proc ::tkdroid::a11y::idFor {key} {
+    variable ids; variable keys; variable nextId; variable seen
+    if {![info exists ids($key)]} {
+	set ids($key) $nextId
+	set keys($nextId) $key
+	incr nextId
+    }
+    dict set seen $key 1
+    return $ids($key)
+}
+
+proc ::tkdroid::a11y::clean {s} {
+    variable maxText
+    set s [string map [list \t " " \n " " \r " "] $s]
+    if {[string length $s] > $maxText} {set s "[string range $s 0 $maxText-1]..."}
+    return $s
+}
+
+proc ::tkdroid::a11y::intersect {r clip} {
+    lassign $r x1 y1 x2 y2
+    lassign $clip cx1 cy1 cx2 cy2
+    set x1 [expr {max($x1, $cx1)}]; set y1 [expr {max($y1, $cy1)}]
+    set x2 [expr {min($x2, $cx2)}]; set y2 [expr {min($y2, $cy2)}]
+    if {$x1 >= $x2 || $y1 >= $y2} {return {}}
+    return [list $x1 $y1 $x2 $y2]
+}
+
+proc ::tkdroid::a11y::emit {key parent rect role flags text value} {
+    variable lines
+    set id [idFor $key]
+    lassign $rect x1 y1 x2 y2
+    lappend lines [join [list $id $parent $x1 $y1 $x2 $y2 $role $flags [clean $text] [clean $value]] \t]
+    return $id
+}
+
+# text shown by a widget: -text, or the value of its -textvariable
+proc ::tkdroid::a11y::textOf {w} {
+    set v ""
+    if {![catch {$w cget -textvariable} var] && $var ne "" && [uplevel #0 [list info exists $var]]} {
+	return [uplevel #0 [list set $var]]
+    }
+    catch {$w cget -text} v
+    return $v
+}
+
+proc ::tkdroid::a11y::isDisabled {w} {
+    if {[catch {$w cget -state} st]} {
+	return [expr {![catch {$w instate disabled} d] && $d}]
+    }
+    return [expr {$st eq "disabled"}]
+}
+
+proc ::tkdroid::a11y::flagsFor {w base} {
+    set f $base
+    if {[isDisabled $w]} {set f [string map {x {}} $f]} else {append f e}
+    if {[focus] eq $w} {append f f}
+    return $f
+}
+
+# role, flags, text and value of one widget; role {} = a container that gets no node of its own
+proc ::tkdroid::a11y::describe {w cls} {
+    switch -- $cls {
+	Button - TButton - Menubutton - TMenubutton {
+	    return [list button [flagsFor $w x] [textOf $w] ""]
+	}
+	Label - TLabel - Message {
+	    set t [textOf $w]
+	    if {$t eq ""} {return {}}
+	    return [list text [flagsFor $w ""] $t ""]
+	}
+	Checkbutton - TCheckbutton {
+	    set on 0
+	    catch {
+		set var [$w cget -variable]
+		set val [uplevel #0 [list set $var]]
+		set on [expr {$val eq [expr {$cls eq "TCheckbutton" ? [$w cget -onvalue] : [$w cget -onvalue]}]}]
+	    }
+	    return [list checkbox [flagsFor $w xc[expr {$on ? "k" : ""}]] [textOf $w] [expr {$on ? "on" : "off"}]]
+	}
+	Radiobutton - TRadiobutton {
+	    set on 0
+	    catch {
+		set var [$w cget -variable]
+		set on [expr {[uplevel #0 [list set $var]] eq [$w cget -value]}]
+	    }
+	    return [list radio [flagsFor $w xc[expr {$on ? "k" : ""}]] [textOf $w] [expr {$on ? "selected" : ""}]]
+	}
+	Entry - TEntry - Spinbox - TSpinbox - TCombobox {
+	    set fl t
+	    if {![catch {$w cget -show} sh] && $sh ne ""} {append fl p}
+	    set v [expr {[string match *p $fl] || [string match *p* $fl] ? [string repeat "•" [string length [$w get]]] : [$w get]}]
+	    return [list edit [flagsFor $w $fl] "" $v]
+	}
+	Text {
+	    # an editable text box is an edit field; a read-only one is just text to read
+	    if {![catch {$w cget -state} st] && $st eq "normal"} {
+		return [list edit [flagsFor $w mlt] "" [$w get 1.0 end-1c]]
+	    }
+	    return [list text [flagsFor $w "ml"] [$w get 1.0 end-1c] ""]
+	}
+	Listbox {return [list list [flagsFor $w l] "" ""]}
+	Treeview {return [list list [flagsFor $w l] "" ""]}
+	Scale - TScale {
+	    set v ""; catch {set v [$w get]}
+	    return [list slider [flagsFor $w l] "" $v]
+	}
+	TProgressbar - Progressbar {
+	    set v ""; catch {set v [$w cget -value]}
+	    return [list progress [flagsFor $w ""] "" $v]
+	}
+	default {return {}}
+    }
+}
+
+# children that are not windows
+proc ::tkdroid::a11y::items {w cls parent rect} {
+    set ox [winfo rootx $w]; set oy [winfo rooty $w]
+    switch -- $cls {
+	Listbox {
+	    set n [$w size]
+	    set sel [$w curselection]
+	    for {set i [$w nearest 0]} {$i < $n} {incr i} {
+		lassign [$w bbox $i] bx by bw bh
+		if {$bw eq ""} break
+		set r [intersect [list [expr {$ox+$bx}] [expr {$oy+$by}] [expr {$ox+$bx+$bw}] [expr {$oy+$by+$bh}]] $rect]
+		if {$r eq ""} {if {$by > [winfo height $w]} break; continue}
+		emit "$w#$i" $parent $r listitem [expr {$i in $sel ? "xes" : "xe"}] [$w get $i] ""
+	    }
+	}
+	Treeview {
+	    set sel [$w selection]
+	    set todo [$w children {}]
+	    set count 0
+	    while {[llength $todo] && [incr count] < 300} {
+		set it [lindex $todo 0]; set todo [lrange $todo 1 end]
+		if {[$w item $it -open]} {set todo [concat [$w children $it] $todo]}
+		set bb [$w bbox $it]
+		if {![llength $bb]} continue
+		lassign $bb bx by bw bh
+		set r [intersect [list [expr {$ox+$bx}] [expr {$oy+$by}] [expr {$ox+$bx+$bw}] [expr {$oy+$by+$bh}]] $rect]
+		if {$r eq ""} continue
+		emit "$w#$it" $parent $r listitem [expr {$it in $sel ? "xes" : "xe"}] [$w item $it -text] [join [$w item $it -values] ", "]
+	    }
+	}
+	Canvas {
+	    set cx [$w canvasx 0]; set cy [$w canvasy 0]
+	    set widgetClickable [expr {[bind $w <ButtonRelease-1>] ne "" || [bind $w <Button-1>] ne ""}]
+	    set count 0
+	    foreach it [$w find all] {
+		if {[$w type $it] ne "text"} continue
+		if {[incr count] > 400} break
+		set bb [$w bbox $it]
+		if {![llength $bb]} continue
+		lassign $bb bx1 by1 bx2 by2
+		set r [intersect [list [expr {$ox + int($bx1 - $cx)}] [expr {$oy + int($by1 - $cy)}] [expr {$ox + int($bx2 - $cx)}] [expr {$oy + int($by2 - $cy)}]] $rect]
+		if {$r eq ""} continue
+		set txt [$w itemcget $it -text]
+		if {$txt eq ""} continue
+		set clickable $widgetClickable
+		foreach tg [$w gettags $it] {if {[$w bind $tg] ne ""} {set clickable 1}}
+		if {[$w bind $it] ne ""} {set clickable 1}
+		emit "$w#$it" $parent $r [expr {$clickable ? "button" : "text"}] [expr {$clickable ? "xe" : "e"}] $txt ""
+	    }
+	}
+    }
+}
+
+proc ::tkdroid::a11y::walk {w parent clip} {
+    if {![winfo exists $w] || ![winfo ismapped $w]} return
+    set x [winfo rootx $w]; set y [winfo rooty $w]
+    set rect [intersect [list $x $y [expr {$x + [winfo width $w]}] [expr {$y + [winfo height $w]}]] $clip]
+    if {$rect eq ""} return
+    set cls [winfo class $w]
+    variable override
+    if {[info exists override($w)] && [dict exists $override($w) hidden] && [dict get $override($w) hidden]} return
+    if {[catch {describe $w $cls} d]} {set d {}}
+    if {[info exists override($w)] && ([dict exists $override($w) name] || [dict exists $override($w) role])} {
+	# the app's own words win: an icon-only button, a custom-drawn widget
+	set o $override($w)
+	lassign [expr {[llength $d] ? $d : {view e "" ""}}] orole oflags otext ovalue
+	set d [list [expr {[dict exists $o role] ? [dict get $o role] : $orole}] $oflags \
+		[expr {[dict exists $o name] ? [dict get $o name] : $otext}] $ovalue]
+    }
+    if {[llength $d]} {
+	lassign $d role flags text value
+	set parent [emit $w $parent $rect $role $flags $text $value]
+    } elseif {[winfo toplevel $w] eq $w && $w ne "."} {
+	set title ""; catch {set title [wm title $w]}
+	set parent [emit $w $parent $rect window e $title ""]
+    }
+    catch {items $w $cls $parent $rect}
+    foreach k [winfo children $w] {walk $k $parent $rect}
+}
+
+# ::tkdroid::accessible window ?-name text? ?-role role? ?-hidden bool?
+#   Say what a widget is, in the screen reader's words: an icon-only button gets a name; a custom-drawn
+#   widget gets a role; decorative widgets can be hidden. Roles: button checkbox radio edit text list
+#   slider progress view.
+proc ::tkdroid::accessible {w args} {
+    variable ::tkdroid::a11y::override
+    set d [dict create]
+    foreach {k v} $args {
+	if {$k ni {-name -role -hidden}} {error "bad option \"$k\": must be -name, -role or -hidden"}
+	dict set d [string range $k 1 end] $v
+    }
+    set override($w) $d
+    return
+}
+
+# the whole screen as snapshot text
+proc ::tkdroid::a11y::snapshot {} {
+    variable lines; variable seen; variable ids; variable keys
+    set lines {}
+    set seen {}
+    set screen [::tkdroid::screen]
+    lassign $screen sw sh
+    walk . 0 [list 0 0 $sw $sh]
+    foreach k [array names ids] {
+	if {![dict exists $seen $k]} {unset keys($ids($k)); unset ids($k)}
+    }
+    return [join $lines \n]
+}
+
+proc ::tkdroid::a11y::enable {on} {
+    variable enabled; variable job; variable last
+    set enabled $on
+    catch {after cancel $job}
+    set job ""
+    set last ""
+    if {$on} {tick}
+}
+
+# while a screen reader is running: re-describe the screen when something was drawn
+proc ::tkdroid::a11y::tick {} {
+    variable enabled; variable job; variable last; variable lastFrames
+    set job ""
+    if {!$enabled} return
+    set f [dict get [::tkdroid::stats] frames]
+    if {$f != $lastFrames || $last eq ""} {
+	set lastFrames $f
+	if {![catch snapshot s] && $s ne $last} {
+	    set last $s
+	    ::tkdroid::a11ysend $s
+	}
+    }
+    set job [after 250 ::tkdroid::a11y::tick]
+}
+
+# ---- actions from the screen reader (the numbers are android.view.accessibility.AccessibilityNodeInfo's)
+proc ::tkdroid::a11y::findRect {id} {
+    variable keys
+    if {![info exists keys($id)]} {return {}}
+    set w [lindex [split $keys($id) #] 0]
+    return $w
+}
+
+proc ::tkdroid::a11y::tapAt {cx cy} {
+    ::tkdroid::touch down $cx $cy
+    after 60 [list ::tkdroid::touch up $cx $cy]
+}
+
+proc ::tkdroid::a11y::action {id action text} {
+    variable keys; variable last
+    # A click arrives with the node's centre (the host's own snapshot): tap there. No bookkeeping needed.
+    if {$action == 16 && [regexp {^(-?\d+) (-?\d+)$} $text -> cx cy]} {
+	tapAt $cx $cy
+	return
+    }
+    if {![info exists keys($id)]} return
+    set key $keys($id)
+    set rect {}
+    foreach l [split $last \n] {
+	set f [split $l \t]
+	if {[lindex $f 0] == $id} {set rect [lrange $f 2 5]; break}
+    }
+    set w [lindex [split $key #] 0]
+    if {![winfo exists $w]} return
+    switch -- $action {
+	16 {	;# click without coordinates: a tap at the centre of the node
+	    if {$rect eq ""} return
+	    lassign $rect x1 y1 x2 y2
+	    tapAt [expr {($x1 + $x2) / 2}] [expr {($y1 + $y2) / 2}]
+	}
+	1 {catch {focus -force $w}}	;# focus
+	2097152 {			;# set text
+	    if {[winfo class $w] in {Entry TEntry Spinbox TSpinbox TCombobox}} {
+		$w delete 0 end; $w insert 0 $text
+	    } elseif {[winfo class $w] eq "Text"} {
+		$w delete 1.0 end; $w insert 1.0 $text
+	    }
+	}
+	4096 - 8192 {			;# scroll forward / backward
+	    set dir [expr {$action == 4096 ? 1 : -1}]
+	    catch {$w yview scroll $dir pages}
+	    if {[winfo class $w] in {Scale TScale}} {
+		catch {$w set [expr {[$w get] + $dir * max(1, [$w cget -resolution])}]}
+	    }
+	}
+    }
+}
diff --git a/library/android.tcl b/library/android.tcl
new file mode 100644
index 0000000..4b7245c
--- /dev/null
+++ b/library/android.tcl
@@ -0,0 +1,395 @@
+# android.tcl --
+#
+#	Touch policy for Tk on Android: what a finger means to the classic widgets.
+#	Sourced at the end of tk.tcl (see upstream/patches/0003) when the Android
+#	platform layer is present. Everything here is ordinary Tk bindings and
+#	procedures, so an application can change or switch any of it off.
+#
+#	  * Dragging on a text, listbox or treeview scrolls it (with momentum), and
+#	    a tap clicks. Set ::tkdroid::touchScroll 0 for the classic mouse feel.
+#	  * Long press on a text-entry widget selects the word under the finger,
+#	    keeps extending the selection while the finger drags, and shows the
+#	    system's Cut/Copy/Paste/Select-all toolbar when it lifts.
+#	  * Long press elsewhere generates the virtual event <<LongPress>>.
+#	  * A two-finger pinch generates <<PinchStart>>, <<Pinch>> and <<PinchEnd>>;
+#	    %d is the cumulative scale factor (1.0 = unchanged) and %x %y the focal point.
+#
+#	  * The Activity lifecycle arrives as <<AndroidPause>>, <<AndroidSaveState>>,
+#	    <<AndroidResume>> and <<AndroidLowMemory>> on ".".
+#
+#	The native side calls ::tkdroid::native; nothing here runs unless the
+#	platform reports a gesture.
+
+namespace eval ::tkdroid {
+    variable touchScroll 1	;# 0: leave Text/Listbox/Treeview mouse bindings alone
+    variable T			;# the touch in progress
+    array set T {mode idle w {} x0 0 y0 0 ly 0 lx 0 t 0 vy 0 vx 0 acc 0 axis y
+	menu {} fling {}}
+    variable orig		;# class bindings that the wrappers below call
+    array set orig {}
+    variable textClasses {Text Entry Spinbox TEntry TCombobox TSpinbox}
+}
+
+# ---- helpers -------------------------------------------------------------
+
+proc ::tkdroid::slop {} {
+    return [expr {max(4, int([winfo pixels . 0.05i]))}]	;# ~8 dp
+}
+
+# Run a saved class binding as if Tk had fired it.
+proc ::tkdroid::run {key w x y} {
+    variable orig
+    if {![info exists orig($key)] || $orig($key) eq ""} return
+    set X [expr {[winfo rootx $w] + $x}]
+    set Y [expr {[winfo rooty $w] + $y}]
+    uplevel #0 [string map [list %% % %W $w %x $x %y $y %X $X %Y $Y %b 1 %s 256] $orig($key)]
+}
+
+# Pixels per scroll unit: 1 for text (it scrolls by pixels), a row for lists.
+proc ::tkdroid::unit {w} {
+    if {[winfo class $w] eq "Text"} {return 1}
+    foreach y {4 20 60 120} {
+	catch {
+	    set i [expr {[winfo class $w] eq "Listbox" ? [$w nearest $y] : [$w identify item 20 $y]}]
+	    set bb [$w bbox $i]
+	    if {[llength $bb] == 4 && [lindex $bb 3] > 0} {return [lindex $bb 3]}
+	}
+    }
+    return [expr {int([font metrics TkDefaultFont -linespace] * 1.5)}]
+}
+
+# Scroll by dpx pixels (+ = show further down/right); keeps the fractional part.
+proc ::tkdroid::scrollBy {w axis dpx} {
+    variable T
+    set u [unit $w]
+    set T(acc) [expr {$T(acc) + $dpx}]
+    set n [expr {int($T(acc) / $u)}]
+    if {$n == 0} {return 0}
+    set T(acc) [expr {$T(acc) - $n * $u}]
+    set view [expr {$axis eq "x" ? "xview" : "yview"}]
+    set before [$w $view]
+    if {$u == 1} {
+	$w $view scroll $n pixels
+    } else {
+	$w $view scroll $n units
+    }
+    return [expr {$before ne [$w $view]}]
+}
+
+# ---- one-finger drag: scroll instead of select ------------------------------------
+
+proc ::tkdroid::Down {w x y} {
+    variable T
+    variable touchScroll
+    catch {after cancel $T(fling)}
+    set T(fling) {}
+    array set T [list w $w x0 $x y0 $y lx $x ly $y t [clock microseconds] vy 0.0 vx 0.0 \
+	    acc 0 axis y menu {}]
+    if {$touchScroll} {
+	set T(mode) pending	;# decided by the first movement, or by the lift (a tap)
+    } else {
+	set T(mode) direct
+	run [winfo class $w],<Button-1> $w $x $y
+    }
+}
+
+proc ::tkdroid::Move {w x y} {
+    variable T
+    set c [winfo class $w]
+    switch -- $T(mode) {
+	pending {
+	    if {hypot($x - $T(x0), $y - $T(y0)) <= [slop]} return
+	    set T(mode) scroll
+	    set T(axis) [expr {$c eq "Text" && abs($x - $T(x0)) > abs($y - $T(y0)) ? "x" : "y"}]
+	    set T(lx) $x; set T(ly) $y
+	    # fall through to scroll
+	    scroll $w $x $y
+	}
+	scroll { scroll $w $x $y }
+	default { run $c,<B1-Motion> $w $x $y }
+    }
+}
+
+proc ::tkdroid::scroll {w x y} {
+    variable T
+    set now [clock microseconds]
+    set dt [expr {max(1.0, ($now - $T(t)) / 1000.0)}]
+    if {$T(axis) eq "x"} {set d [expr {$T(lx) - $x}]} else {set d [expr {$T(ly) - $y}]}
+    set T(t) $now; set T(lx) $x; set T(ly) $y
+    # smoothed velocity in pixels per millisecond
+    set T(vy) [expr {0.7 * $T(vy) + 0.3 * ($d / $dt)}]
+    scrollBy $w $T(axis) $d
+}
+
+proc ::tkdroid::Up {w x y} {
+    variable T
+    set c [winfo class $w]
+    switch -- $T(mode) {
+	pending {		;# a tap
+	    run $c,<Button-1> $w $T(x0) $T(y0)
+	    run $c,<ButtonRelease-1> $w $x $y
+	}
+	scroll {
+	    # momentum only if the finger was still moving when it lifted
+	    if {([clock microseconds] - $T(t)) < 80000 && abs($T(vy)) > 0.15} {
+		set T(fling) [after 16 [list ::tkdroid::Fling $w]]
+	    }
+	}
+	default { run $c,<ButtonRelease-1> $w $x $y }
+    }
+    set T(mode) idle
+}
+
+proc ::tkdroid::Leave {w x y} {
+    variable T
+    if {$T(mode) in {pending scroll}} return	;# no auto-scan while the finger scrolls
+    run [winfo class $w],<B1-Leave> $w $x $y
+}
+
+proc ::tkdroid::Fling {w} {
+    variable T
+    set T(fling) {}
+    if {![winfo exists $w]} return
+    set d [expr {$T(vy) * 16}]
+    if {abs($d) < 0.4} return
+    if {![scrollBy $w $T(axis) $d] && abs($d) >= [unit $w]} return	;# hit an end
+    set T(vy) [expr {$T(vy) * 0.95}]
+    set T(fling) [after 16 [list ::tkdroid::Fling $w]]
+}
+
+# ---- long press and the text toolbar --------------------------------------------------
+
+proc ::tkdroid::LongPress {X Y} {
+    variable T
+    variable textClasses
+    set w [winfo containing $X $Y]
+    if {$w eq ""} return
+    set x [expr {$X - [winfo rootx $w]}]
+    set y [expr {$Y - [winfo rooty $w]}]
+    set c [winfo class $w]
+    if {$c ni $textClasses} {
+	catch {event generate $w <<LongPress>> -x $x -y $y}
+	return
+    }
+    if {$T(mode) eq "pending" && $T(w) eq $w} {
+	run $c,<Button-1> $w $T(x0) $T(y0)	;# the press we were still holding back
+    }
+    set T(mode) select
+    if {[$w cget -state] eq "disabled"} {
+	set T(mode) idle
+	return
+    }
+    focus $w
+    run $c,<Double-Button-1> $w $x $y	;# select the word, exactly as a double click would
+    set T(menu) [list $X $Y]
+}
+
+# bound to <ButtonRelease-1> on "all": the lift that ends a long press shows the toolbar
+proc ::tkdroid::AnyUp {} {
+    variable T
+    if {$T(menu) eq ""} return
+    lassign $T(menu) X Y
+    set T(menu) {}
+    after idle [list ::tkdroid::ShowMenu $X $Y]
+}
+
+proc ::tkdroid::ShowMenu {X Y} {
+    set w [focus]
+    if {$w eq "" || ![winfo exists $w]} return
+    set flags 8				;# select all
+    if {[winfo class $w] eq "Text"} {
+	set has [llength [$w tag ranges sel]]
+	set editable [expr {[$w cget -state] eq "normal"}]
+    } else {
+	set has [$w selection present]
+	set editable [expr {[$w cget -state] eq "normal"}]
+    }
+    if {$has} {
+	set flags [expr {$flags | 2 | ($editable ? 1 : 0)}]
+    }
+    if {$editable && ![catch {::clipboard get} clip] && $clip ne ""} {
+	set flags [expr {$flags | 4}]
+    }
+    textmenu $X $Y $flags
+}
+
+# A choice in the toolbar (the code is TKA_MENU_*).
+proc ::tkdroid::TextAction {code} {
+    set w [focus]
+    if {$w eq "" || ![winfo exists $w]} return
+    switch -- $code {
+	1 { event generate $w <<Cut>> }
+	2 { event generate $w <<Copy>> }
+	4 { event generate $w <<Paste>> }
+	8 {
+	    event generate $w <<SelectAll>>
+	    set X [expr {[winfo rootx $w] + [winfo width $w] / 2}]
+	    set Y [expr {[winfo rooty $w] + [winfo height $w] / 2}]
+	    after idle [list ::tkdroid::ShowMenu $X $Y]
+	}
+    }
+}
+
+# ---- pinch ---------------------------------------------------------------------------------
+
+proc ::tkdroid::Pinch {phase X Y scale1000} {
+    set w [winfo containing $X $Y]
+    if {$w eq ""} {set w .}
+    set x [expr {$X - [winfo rootx $w]}]
+    set y [expr {$Y - [winfo rooty $w]}]
+    set ev [lindex {<<PinchStart>> <<Pinch>> <<PinchEnd>>} $phase]
+    catch {event generate $w $ev -x $x -y $y -data [format %.3f [expr {$scale1000 / 1000.0}]]}
+}
+
+# ---- Activity lifecycle ------------------------------------------------------------------------
+#
+#	<<AndroidPause>>/<<AndroidSaveState>>  the app is leaving the foreground: save now (Android
+#	    may kill the process any time after this; the Activity waits briefly for the handlers)
+#	<<AndroidResume>>                      back in the foreground
+#	<<AndroidLowMemory>>                   the system wants memory back: drop caches
+#	All are generated on ".", so `bind . <<AndroidPause>> {...}` or `bind all` receives them.
+
+proc ::tkdroid::Lifecycle {kind} {
+    set events [lindex {{<<AndroidPause>> <<AndroidSaveState>>} {<<AndroidResume>>} {<<AndroidLowMemory>>}} $kind]
+    foreach ev $events {
+	if {[catch {event generate . $ev} err]} {catch {after idle [list error $err]}}
+	update idletasks
+    }
+}
+
+# ---- platform services (file picker, share, open a link, permissions, notifications) ----------------------
+#
+# Each asks Android to do something, possibly showing system UI, and reports back LATER: the -command
+# script is called with two more arguments, a status (ok, cancelled, denied or error) and a list of
+# results. The app keeps running meanwhile. Picked files are copied into the app's cache directory first,
+# so the results are ordinary file paths that any Tcl file command can read.
+#
+#   ::tkdroid::pickfile  -command cmd ?-types {mime ...}? ?-multiple 1?       results: local file paths
+#   ::tkdroid::savefile  -source file -name name -command cmd ?-type mime?     results: the saved name
+#   ::tkdroid::share     ?-text t? ?-file path? ?-type mime? ?-title t? ?-command cmd?
+#   ::tkdroid::openurl   url ?-command cmd?                           (http, https, mailto, tel, geo, sms)
+#   ::tkdroid::permission request perm ?perm ...? -command cmd         results: the granted permissions
+#   ::tkdroid::notify    -title t -text t ?-command cmd?
+#   ::tkdroid::permitted perm                                          1 if granted (synchronous)
+
+namespace eval ::tkdroid { variable pending; array set pending {} }
+
+proc ::tkdroid::async {kind opts cmd} {
+    variable pending
+    set id [request $kind {*}$opts]
+    if {$cmd ne ""} {set pending($id) $cmd}
+    return $id
+}
+
+proc ::tkdroid::Result {id status payload} {
+    variable pending
+    if {![info exists pending($id)]} return
+    set cmd $pending($id)
+    unset pending($id)
+    set results [expr {$payload eq "" ? {} : [split $payload \n]}]
+    uplevel #0 [list {*}$cmd $status $results]
+}
+
+# split "-opt value ..." into a dict, rejecting unknown options
+proc ::tkdroid::options {optlist allowed} {
+    set d [dict create]
+    foreach {k v} $optlist {
+	if {$k ni $allowed} {error "bad option \"$k\": must be [join $allowed {, }]"}
+	dict set d [string range $k 1 end] $v
+    }
+    return $d
+}
+
+proc ::tkdroid::pickfile {args} {
+    set o [options {*}[list $args {-command -types -multiple}]]
+    if {![dict exists $o command]} {error "pickfile needs -command"}
+    set a {}
+    if {[dict exists $o types]} {lappend a types [join [dict get $o types] ,]}
+    if {[dict exists $o multiple]} {lappend a multiple [expr {[dict get $o multiple] ? 1 : 0}]}
+    async pickfile $a [dict get $o command]
+}
+
+proc ::tkdroid::savefile {args} {
+    set o [options {*}[list $args {-command -source -name -type}]]
+    foreach need {command source name} {if {![dict exists $o $need]} {error "savefile needs -$need"}}
+    if {![file readable [dict get $o source]]} {error "cannot read [dict get $o source]"}
+    set a [list source [file normalize [dict get $o source]] name [dict get $o name]]
+    if {[dict exists $o type]} {lappend a type [dict get $o type]}
+    async savefile $a [dict get $o command]
+}
+
+proc ::tkdroid::share {args} {
+    set o [options {*}[list $args {-text -file -type -title -command}]]
+    if {![dict exists $o text] && ![dict exists $o file]} {error "share needs -text or -file"}
+    set a {}
+    foreach k {text type title} {if {[dict exists $o $k]} {lappend a $k [dict get $o $k]}}
+    if {[dict exists $o file]} {
+	if {![file readable [dict get $o file]]} {error "cannot read [dict get $o file]"}
+	lappend a file [file normalize [dict get $o file]]
+    }
+    async share $a [expr {[dict exists $o command] ? [dict get $o command] : ""}]
+}
+
+proc ::tkdroid::openurl {url args} {
+    set o [options {*}[list $args {-command}]]
+    async openurl [list url $url] [expr {[dict exists $o command] ? [dict get $o command] : ""}]
+}
+
+proc ::tkdroid::permission {sub args} {
+    if {$sub ne "request"} {error "bad subcommand \"$sub\": must be request"}
+    set perms {}
+    set cmd ""
+    while {[llength $args]} {
+	set a [lindex $args 0]
+	if {$a eq "-command"} {set cmd [lindex $args 1]; set args [lrange $args 2 end]} else {lappend perms $a; set args [lrange $args 1 end]}
+    }
+    if {![llength $perms] || $cmd eq ""} {error "usage: permission request perm ?perm ...? -command cmd"}
+    async permission [list permissions [join $perms ,]] $cmd
+}
+
+proc ::tkdroid::notify {args} {
+    set o [options {*}[list $args {-title -text -command}]]
+    foreach need {title text} {if {![dict exists $o $need]} {error "notify needs -$need"}}
+    async notify [list title [dict get $o title] text [dict get $o text]] [expr {[dict exists $o command] ? [dict get $o command] : ""}]
+}
+
+# ---- entry point for the platform layer ------------------------------------------------------
+
+proc ::tkdroid::native {kind a b c d} {
+    switch -- $kind {
+	longpress { LongPress $a $b }
+	pinch { Pinch $a $b $c $d }
+	textaction { TextAction $a }
+	lifecycle { Lifecycle $a }
+	result { Result $a $b $c }
+	a11yenable { ::tkdroid::a11y::enable $a }
+	a11yaction { ::tkdroid::a11y::action $a $b $c }
+    }
+}
+
+proc ::tkdroid::install {} {
+    variable orig
+    variable textClasses
+    foreach c {Text Listbox Treeview} {
+	foreach seq {<Button-1> <B1-Motion> <ButtonRelease-1> <B1-Leave>} {
+	    set orig($c,$seq) [bind $c $seq]
+	}
+	bind $c <Button-1> {::tkdroid::Down %W %x %y}
+	bind $c <B1-Motion> {::tkdroid::Move %W %x %y}
+	bind $c <ButtonRelease-1> {::tkdroid::Up %W %x %y}
+	bind $c <B1-Leave> {::tkdroid::Leave %W %x %y}
+    }
+    foreach c $textClasses {
+	set orig($c,<Double-Button-1>) [bind $c <Double-Button-1>]
+    }
+    bind all <ButtonRelease-1> {+::tkdroid::AnyUp}
+    # Hardware keyboards: Ctrl+A selects all, as on every Android text field (Tk's X11 default is the
+    # Emacs "go to line start"; Home does that here).
+    catch {event delete <<LineStart>> <Control-Key-a>}
+    event add <<SelectAll>> <Control-Key-a>
+}
+
+::tkdroid::install
+
+# screen-reader support (loaded here so a script can also call ::tkdroid::a11y::snapshot directly)
+source -encoding utf-8 [file join $::tk_library a11y.tcl]
