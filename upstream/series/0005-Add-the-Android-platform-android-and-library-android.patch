+    (void) cd;
+    if (objc != 4) {
+	Tcl_WrongNumArgs(interp, 1, objv, "down|up|move|cancel x y");
+	return TCL_ERROR;
+    }
+    if (Tcl_GetIndexFromObj(interp, objv[1], actions, "action", 0, &act) != TCL_OK
+	    || Tcl_GetIntFromObj(interp, objv[2], &x) != TCL_OK
+	    || Tcl_GetIntFromObj(interp, objv[3], &y) != TCL_OK) {
+	return TCL_ERROR;
+    }
+    TkAQueueTouch(act, x, y);
+    return TCL_OK;
+}
+
+static int
+KeyCmd(void *cd, Tcl_Interp *interp, Tcl_Size objc, Tcl_Obj *const objv[])
+{
+    int down, cp, state = 0;
+    const char *name;
+    KeySym ks;
+
+    (void) cd;
+    if (objc != 3 && objc != 4) {
+	Tcl_WrongNumArgs(interp, 1, objv, "down|up keysymName-or-char ?modifierState?");
+	return TCL_ERROR;
+    }
+    if (objc == 4 && Tcl_GetIntFromObj(interp, objv[3], &state) != TCL_OK) {
+	return TCL_ERROR;
+    }
+    down = strcmp(Tcl_GetString(objv[1]), "down") == 0;
+    name = Tcl_GetString(objv[2]);
+    ks = XStringToKeysym(name);
+    if (ks != NoSymbol) {
+	TkAQueueKey(down, (int) ks, 0, state);
+    } else if (Tcl_UtfToUniChar(name, &cp) > 0) {
+	TkAQueueKey(down, 0, cp, state);
+    }
+    return TCL_OK;
+}
