+    ev.xexpose.send_event = False;
+    ev.xexpose.display = tkA.display;
+    ev.xexpose.window = TKA_ID(d);
+    ev.xexpose.x = r.x1;
+    ev.xexpose.y = r.y1;
+    ev.xexpose.width = r.x2 - r.x1;
+    ev.xexpose.height = r.y2 - r.y1;
