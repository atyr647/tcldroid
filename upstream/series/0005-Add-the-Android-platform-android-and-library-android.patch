+	return TCL_ERROR;
+    }
+    kbRequested = Tcl_GetString(objv[1])[0] == 's';
+    kbShown = kbRequested;
+    if (tkAHost.keyboard != NULL) {
+	tkAHost.keyboard(kbRequested);
+    }
