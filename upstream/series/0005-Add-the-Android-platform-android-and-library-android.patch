+
+int XWarpPointer(Display *d, Window s, Window dw, int sx, int sy, unsigned w, unsigned h, int dx, int dy)
+{ (void) d; (void) s; (void) dw; (void) sx; (void) sy; (void) w; (void) h; (void) dx; (void) dy; return 1; }
+/*
+ * `event generate ... -warp 1`: move the (virtual) pointer and let Tk generate the crossing events,
+ * as the macOS port does after CGWarpMouseCursorPosition.
+ */
+void
+TkpWarpPointer(TkDisplay *dispPtr)
+{
+    int x, y;
+    Tk_Window w;
+
+    if (dispPtr->warpWindow != NULL) {
+	Tk_GetRootCoords(dispPtr->warpWindow, &x, &y);
+	x += dispPtr->warpX;
+	y += dispPtr->warpY;
+    } else {
+	x = dispPtr->warpX;
+	y = dispPtr->warpY;
+    }
+    tkA.ptrX = x;
+    tkA.ptrY = y;
+    w = dispPtr->warpMainwin != NULL ? Tk_CoordsToWindow(x, y, dispPtr->warpMainwin) : NULL;
+    Tk_UpdatePointer(w, x, y, tkA.ptrState);
+}
+void TkpSetCursor(TkpCursor cursor) { (void) cursor; }
+/* An entry/text widget with the focus placed its insertion caret: the host shows the soft keyboard. */
+void
+Tk_SetCaretPos(Tk_Window tkwin, int x, int y, int height)
+{
+    int rx, ry;
+    TkWindow *winPtr = (TkWindow *) tkwin;
+    TkDisplay *dispPtr = winPtr->dispPtr;
+
+    /* `tk caret` reports this record, as on the other platforms (unix/tkUnixKey.c) */
+    dispPtr->caret.winPtr = winPtr;
+    dispPtr->caret.x = x;
+    dispPtr->caret.y = y;
+    dispPtr->caret.height = height;
+    UpdateKeyboard();
+    if (tkAHost.caret != NULL) {
+	Tk_GetRootCoords(tkwin, &rx, &ry);
+	tkAHost.caret(rx + x, ry + y, height);
+    }
+}
+
+/*
+ * Soft keyboard policy (a phone convention, not a Tk one): the keyboard appears when
+ * the user *touches* a text-input widget that then holds the focus, and goes away when
+ * focus leaves it or the user touches something else. Scripts can force it with
+ * `::tkdroid::keyboard show|hide`.
+ */
+static int
+IsTextWidget(TkWindow *w)
+{
+    const char *c = w != NULL ? Tk_Class((Tk_Window) w) : NULL;
+
+    return c != NULL && (strcmp(c, "Entry") == 0 || strcmp(c, "Text") == 0
+	    || strcmp(c, "Spinbox") == 0 || strcmp(c, "TEntry") == 0
+	    || strcmp(c, "TCombobox") == 0 || strcmp(c, "TSpinbox") == 0);
+}
+
+static void
+UpdateKeyboard(void)
+{
+    TkWindow *f = tkA.dispPtr != NULL ? tkA.dispPtr->focusPtr : NULL;
+    int want = kbRequested && f != NULL && IsTextWidget(f);
+
+    if (want != kbShown) {
+	kbShown = want;
+	if (tkAHost.keyboard != NULL) {
+	    tkAHost.keyboard(want);
+	}
+    }
+}
+
+/*
+ * Gesture policy lives in Tcl (library/android.tcl): the native side only reports what
+ * the platform saw. Calls ::tkdroid::native kind a b c d; a script error goes to
+ * bgerror like any other event-handler error. Silently ignored if the policy script
+ * is not loaded.
+ */
+static void
+CallScript(const char *kind, int a, int b, int c, int d)
+{
+    TkMainInfo *mainInfo = TkGetMainInfoList();
+    Tcl_Interp *interp = mainInfo != NULL ? mainInfo->interp : NULL;
+    Tcl_Obj *argv[6];
+    int i;
+
+    if (interp == NULL || Tcl_FindCommand(interp, "::tkdroid::native", NULL, TCL_GLOBAL_ONLY) == NULL) {
+	return;
+    }
+    argv[0] = Tcl_NewStringObj("::tkdroid::native", TCL_AUTO_LENGTH);
+    argv[1] = Tcl_NewStringObj(kind, TCL_AUTO_LENGTH);
+    argv[2] = Tcl_NewIntObj(a);
+    argv[3] = Tcl_NewIntObj(b);
+    argv[4] = Tcl_NewIntObj(c);
+    argv[5] = Tcl_NewIntObj(d);
+    for (i = 0; i < 6; i++) {
+	Tcl_IncrRefCount(argv[i]);
+    }
+    Tcl_Preserve(interp);
+    if (Tcl_EvalObjv(interp, 6, argv, TCL_EVAL_GLOBAL) != TCL_OK) {
+	Tcl_BackgroundException(interp, TCL_ERROR);
+    }
+    Tcl_Release(interp);
+    for (i = 0; i < 6; i++) {
+	Tcl_DecrRefCount(argv[i]);
+    }
+}
+
+/* ::tkdroid::native result id status payload */
+static void
+DeliverResult(const char *kind, int id, const char *status, const char *payload)
+{
+    TkMainInfo *mainInfo = TkGetMainInfoList();
+    Tcl_Interp *interp = mainInfo != NULL ? mainInfo->interp : NULL;
+    Tcl_Obj *argv[6];
+    int i;
+
+    if (interp == NULL || Tcl_FindCommand(interp, "::tkdroid::native", NULL, TCL_GLOBAL_ONLY) == NULL) {
+	return;
+    }
+    argv[0] = Tcl_NewStringObj("::tkdroid::native", TCL_AUTO_LENGTH);
+    argv[1] = Tcl_NewStringObj(kind, TCL_AUTO_LENGTH);
+    argv[2] = Tcl_NewIntObj(id);
+    argv[3] = Tcl_NewStringObj(status, TCL_AUTO_LENGTH);
+    argv[4] = Tcl_NewStringObj(payload, TCL_AUTO_LENGTH);
+    argv[5] = Tcl_NewIntObj(0);
+    for (i = 0; i < 6; i++) {
+	Tcl_IncrRefCount(argv[i]);
+    }
+    Tcl_Preserve(interp);
+    if (Tcl_EvalObjv(interp, 6, argv, TCL_EVAL_GLOBAL) != TCL_OK) {
+	Tcl_BackgroundException(interp, TCL_ERROR);
+    }
+    Tcl_Release(interp);
+    for (i = 0; i < 6; i++) {
+	Tcl_DecrRefCount(argv[i]);
+    }
+}
+
+static void
+ProcessTouch(const Rec *r)
+{
+    /*
+     * Like the Windows port: tell Tk_UpdatePointer which window the pointer is really
+     * over, even while a button is down. Tk's own pointer module (generic/tkPointer.c)
+     * then applies the implicit grab, so a finger that slides off a button leaves it
+     * (and lifting there does not click), exactly as with a mouse.
+     */
+    TkADrawable *d = TkAWindowAt(r->b, r->c);
+    TkWindow *w = NULL;
+    int state, x = r->b, y = r->c;
+
+    while (w == NULL && d != NULL) {
+	w = d->winPtr;
+	d = d->parent;
+    }
+    if (r->a == 0) {		/* finger down: decide what the keyboard should do */
+	if (IsTextWidget(w)) {
+	    kbRequested = 1;
+	} else if (kbRequested) {
+	    kbRequested = 0;
+	    if (kbShown && w != NULL) {
+		TkSetFocusWin(TopOf(w), 0);	/* the caret goes away with the keyboard */
+	    }
+	}
+    }
+    if (r->a == 3) {
+	/* Cancelled (system gesture, a second finger, ...): the pointer leaves every
+	 * window before the button is released, so no widget treats it as a click. */
+	x = y = -30000;
+	w = NULL;
+	tkA.ptrX = tkA.ptrY = x;
+	Tk_UpdatePointer(NULL, x, y, Button1Mask);
+	Tk_UpdatePointer(NULL, x, y, 0);
+	return;
+    }
+    tkA.ptrX = x;
+    tkA.ptrY = y;
+    state = (r->a == 0 || r->a == 2) ? Button1Mask : 0;
+    tkA.ptrState = state;
+    Tk_UpdatePointer((Tk_Window) w, x, y, state);
+}
+
+static void
+ProcessKey(const Rec *r)
+{
+    XEvent ev;
+    TkWindow *target = tkA.dispPtr != NULL ? tkA.dispPtr->focusPtr : NULL;
+
+    if (target == NULL) {
+	target = activeTop;
+    }
+    if (target == NULL || target->window == None) {
+	return;
+    }
+    memset(&ev, 0, sizeof(ev));
+    ev.type = r->a ? KeyPress : KeyRelease;
+    ev.xkey.serial = TkANextSerial();
+    ev.xkey.display = tkA.display;
+    ev.xkey.window = target->window;
+    ev.xkey.root = TKA_ID(tkA.root);
+    ev.xkey.subwindow = None;
+    ev.xkey.time = TkpGetMS();
+    ev.xkey.state = (unsigned) r->c;
+    ev.xkey.keycode = (unsigned) r->b;	/* keycode == keysym on this platform */
+    ev.xkey.same_screen = True;
+    Tk_QueueWindowEvent(&ev, TCL_QUEUE_TAIL);
+}
+
+/* ---- the Tcl event source ------------------------------------------------------------ */
+
+static void PresentIdle(void *cd);
+
+/*
+ * Start-up hold. An app builds its first screen over a second or more, and calls `update`
+ * on the way (for example to learn the window size). Presenting those intermediate frames
+ * shows the user a blank window, then a half-built UI. So frames are withheld, and the host's
+ * splash screen stays up, until the app is ready: it enters the blocking event loop (vwait,
+ * tkwait, mainloop: the normal end of start-up), or calls ::tkdroid::ready, or 4 seconds
+ * pass. `update` never releases the hold.
+ */
+static int hold = 1;
+static Tcl_TimerToken holdTimer;
+
+void
+TkAReady(void)
+{
+    if (hold) {
+	hold = 0;
+	if (holdTimer != NULL) {
+	    Tcl_DeleteTimerHandler(holdTimer);
+	    holdTimer = NULL;
+	}
+    }
+}
+
+static void
+HoldTimeout(void *cd)
+{
+    (void) cd;
+    holdTimer = NULL;
+    TkAReady();
+}
+
+static void
+SetupProc(void *cd, int flags)
+{
+    (void) cd;
+    if (!(flags & TCL_WINDOW_EVENTS)) {
+	return;
+    }
+    if (hold && !(flags & TCL_DONT_WAIT)) {
+	TkAReady();		/* the app is waiting for events: start-up is over */
+    }
+    if (!QueueEmpty() || !NoResults() || (tkA.dirty && !hold && !presentScheduled && tkAHost.present != NULL)) {
+	Tcl_Time t = {0, 0};
+
+	Tcl_SetMaxBlockTime(&t);
+    }
+}
+
+static void
+CheckProc(void *cd, int flags)
+{
+    Rec r;
+
+    (void) cd;
+    if (!(flags & TCL_WINDOW_EVENTS)) {
+	return;
+    }
+    UpdateKeyboard();
+    while (Pop(&r)) {
+	/* A finger moving faster than we draw leaves a backlog of positions; only the latest
+	 * matters. Dropping the older moves keeps the screen under the finger instead of lagging
+	 * behind it. (Down, up and cancel are never dropped.) */
+	if (r.kind == REC_TOUCH && r.a == 2 && NextIsMove()) {
+	    continue;
+	}
+	switch (r.kind) {
+	case REC_TOUCH:
+	    ProcessTouch(&r);
+	    break;
+	case REC_KEY:
+	    ProcessKey(&r);
+	    break;
+	case REC_BACK:
+	    TkAHandleBack();
+	    break;
+	case REC_RESIZE:
+	    TkAndroidResize(r.a, r.b, (double) r.c);
+	    break;
+	case REC_CLIP:
+	    TkAClipboardChanged();
+	    break;
+	case REC_LONG:
+	    CallScript("longpress", r.a, r.b, 0, 0);
+	    break;
+	case REC_PINCH:
+	    CallScript("pinch", r.a, r.b, r.c, r.d);
+	    break;
+	case REC_ACTION:
+	    CallScript("textaction", r.a, 0, 0, 0);
+	    break;
+	case REC_LIFE:
+	    CallScript("lifecycle", r.a, 0, 0, 0);
+	    if (tkAHost.lifecycleDone != NULL) {
+		tkAHost.lifecycleDone(r.a);
+	    }
+	    break;
+	}
+    }
+    {
+	Res *res;
+
+	while ((res = PopResult()) != NULL) {
+	    DeliverResult(res->kind, res->id, res->status, res->payload);
+	    free(res->kind);
+	    free(res->status);
+	    free(res->payload);
+	    free(res);
+	}
+    }
+    if (tkA.dirty && !hold && !presentScheduled && !draining && tkAHost.present != NULL) {
+	presentScheduled = 1;
+	Tcl_DoWhenIdle(PresentIdle, NULL);
+    }
+}
+
+/*
+ * Push whatever changed since the last frame to the host.
+ *
+ * Tk redraws widgets from idle handlers that are queued while it processes the
+ * Expose events we generate, i.e. *after* the idle handler that brought us here.
+ * Presenting immediately would show a frame with backgrounds but no widget content
+ * (a visible flash of an empty UI). So first drain pending window events and idle
+ * work (nothing else: no timers), then present the finished frame.
+ */
+static void
+PresentIdle(void *cd)
+{
+    TkARect r;
+    double t0, t1, t2;
+
+    (void) cd;
+    presentScheduled = 0;
+    if (!tkA.dirty || draining) {
+	return;
+    }
+    t0 = NowMs();
+    draining = 1;
+    while (Tcl_DoOneEvent(TCL_WINDOW_EVENTS | TCL_IDLE_EVENTS | TCL_DONT_WAIT)) {
+	/* keep going until Tk has nothing left to draw */
+    }
+    draining = 0;
+    t1 = NowMs();
+    r = tkA.dirtyRect;
+    tkA.dirty = 0;
+    if (r.x1 < 0) r.x1 = 0;
+    if (r.y1 < 0) r.y1 = 0;
+    if (r.x2 > tkA.width) r.x2 = tkA.width;
+    if (r.y2 > tkA.height) r.y2 = tkA.height;
+    if (tkAHost.present != NULL && r.x1 < r.x2 && r.y1 < r.y2) {
+	tkAHost.present(tkA.root->pix, tkA.width, tkA.height, r.x1, r.y1, r.x2, r.y2);
+	t2 = NowMs();
+	Record(&drawStat, t1 - t0);
+	Record(&presentStat, t2 - t1);
+	statFrames++;
+	lastArea = (long) (r.x2 - r.x1) * (long) (r.y2 - r.y1);
+    }
+}
