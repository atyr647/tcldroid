diff --git a/android/README.md b/android/README.md
new file mode 100644
index 0000000..8e8f5be
--- /dev/null
+++ b/android/README.md
@@ -0,0 +1,41 @@
+# Tk for Android: the `android/` platform directory
+
+A native Android backend for Tk, modelled on `win/` and `macosx/`. It implements Tk's own Xlib-shaped
+API (`Drawable`, `GC`, `XEvent`, `XDrawLine`, ...) in-process, with no X server, no X protocol and no
+X11 library, and lets all of `generic/` run unchanged. This is the same relationship the Windows and macOS
+ports have to Xlib. Widgets keep their upstream drawing code (the Unix button/scrollbar/menu files are reused
+as they are).
+
+## What is here
+
+| File | Role |
+| --- | --- |
+| `tkAndroid.h` | The host interface: callbacks (present a frame, clipboard, keyboard, sounds, ...), the text-engine interface, thread-safe input queues. Contains no Tk internals, so a host (an Activity, or a test driver) can include it alone. |
+| `tkAndroidPort.h`, `tkAndroidInt.h`, `tkAndroidDefault.h`, `tkAndroidPriv.h` | Platform headers (public port header, internal declarations, default options, port-private types). |
+| `tkAndroidWindow.c` | The in-process "X server": window tree, stacking, mapping, exposure, pixmaps, clipping. |
+| `tkAndroidDraw.c` | Software rasteriser behind the Xlib drawing calls; images; text blits with a rendered-text cache. |
+| `tkAndroidRegion.c` | Regions as rectangle lists. |
+| `tkAndroidEvent.c` | Tcl event source, touch/key/back queues, focus, pointer, key symbols, start-up frame hold. |
+| `tkAndroidWm.c` | Window manager policy for a single-surface device: `.` fills the screen, other toplevels are layers inside it, Back maps to `WM_DELETE_WINDOW`, all `wm` subcommands accepted. |
+| `tkAndroidFont.c`, `tkAndroidTestEngine.c` | Fonts on a pluggable text engine (on a device: `android.graphics.Paint` through the host; for desktop tests: FreeType). |
+| `tkAndroidColor.c`, `tkAndroidDisplay.c` | Colours, cursors (validated, never shown), display and initialisation, library mounting from the shared object (zipfs). |
+| `tkAndroidSelect.c` | Selection and clipboard: PRIMARY inside Tk, CLIPBOARD on the system clipboard through the host. |
+| `tkAndroidSystem.c` | Feedback and services hooks: vibration, haptics, sound, `bell`, device facts, asynchronous requests (file picker, share, permissions), input mode, accessibility hand-off. |
+| `../library/android.tcl`, `../library/a11y.tcl` | Touch policy (scrolling, long-press selection, gestures) and the accessibility description of the widget tree, in Tcl. |
+
+## Building and testing
+
+Tk's own build system is not used by the Android port yet; the port's repository (tcldroid) builds the
+sources listed in `unix/Makefile.in` plus `android/*.c` with the NDK, and builds the same code with a
+desktop compiler (`-DTK_ANDROID_PORT`) to run Tk's own test suite (9,742 tests; 86.7% pass, every
+remaining failure triaged; 0 AddressSanitizer errors). Differences from upstream behaviour that the
+suite shows are listed with reasons in that repository (`tests/tk/expected-failures.txt`).
+
+## Known differences from desktop Tk
+
+`tk windowingsystem` returns `x11` (existing scripts select styles with it; this port reuses Unix widget
+drawing). Multiple top-level windows are layers in one surface; `wm geometry` is recorded, not applied, for
+`.`. No `send`, no embedding (`-container`/`-use`), no X selection protocol between processes.
+Shapes are not anti-aliased (classic Tk look); text is shaped and anti-aliased by the platform text engine.
+
+See `docs/` in the tcldroid repository for the architecture decisions and the compatibility policy.
diff --git a/android/tkAndroid.h b/android/tkAndroid.h
new file mode 100644
index 0000000..fc5aeeb
--- /dev/null
+++ b/android/tkAndroid.h
@@ -0,0 +1,140 @@
+/*
+ * tkAndroid.h --
+ *
+ *	Public interface of the Tk Android platform layer, for the host (the
+ *	Android JNI glue, or a test driver). Deliberately independent of Tk's
+ *	internal headers so a host can include it without them.
+ *
+ *	Threading: everything here runs on the Tcl thread, except the functions
+ *	marked thread-safe (the TkAQueue* family), which the UI thread calls.
+ */
+#ifndef TKANDROID_H
+#define TKANDROID_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ---- host callbacks ---------------------------------------------------------------- */
+
+/*
+ * The host (the Android Activity, or a test driver) receives frames and
+ * platform requests through these. All are called on the Tcl thread.
+ */
+typedef void (*TkAPresentProc)(const uint32_t *pix, int w, int h, int x1, int y1,
+	int x2, int y2);
+
+typedef struct TkAHost {
+    TkAPresentProc present;		/* screen changed: pixels 0xAARRGGBB */
+    void (*setTitle)(const char *utf8);
+    void (*setFullscreen)(int on);
+    void (*backUnhandled)(void);	/* Back pressed, no WM_DELETE_WINDOW handler */
+    void (*moveToBack)(void);		/* `wm iconify .` */
+    void (*caret)(int x, int y, int height);	/* text caret moved (IME cursor position) */
+    void (*keyboard)(int show);		/* show or hide the soft keyboard */
+    /* System clipboard (text only). getClipboard returns malloc'd UTF-8, or NULL if
+     * it holds no text; setClipboard(NULL) empties it. Either may be NULL: Tk then keeps
+     * a private in-process clipboard (headless tests). */
+    char *(*getClipboard)(void);
+    void (*setClipboard)(const char *utf8);
+    /* Show the native text-editing toolbar (Cut/Copy/Paste/Select all) near (x, y) in
+     * screen pixels. flags: TKA_MENU_* bits. */
+    void (*textMenu)(int x, int y, int flags);
+    /* Device feedback. All optional (NULL = silently nothing). */
+    void (*vibrate)(int ms, int amplitude);	/* amplitude 1..255, 0 = device default */
+    void (*haptic)(int kind);			/* TKA_HAPTIC_*: the system's own haptic patterns */
+    void (*soundPreload)(const char *path);	/* decode a WAV/OGG/MP3 file ahead of time */
+    void (*soundPlay)(const char *path, int volume1000, int rate1000);
+    void (*soundStop)(void);
+    void (*bell)(void);				/* Tk's `bell` */
+    /* The script finished handling a TKA_LIFE_* event (see TkAQueueLifecycle). */
+    void (*lifecycleDone)(int kind);
+    /* Device and app facts as "key<TAB>value<LF>" lines, malloc'd (::tkdroid::device). */
+    char *(*systemInfo)(void);
+    /* Asynchronous platform service (file picker, share, permissions, ...). The host starts the
+     * work and, when it finishes (any thread), calls TkAQueueResult with the same id. kind and
+     * args are NUL-terminated UTF-8; args is "key<TAB>value<LF>" lines. */
+    void (*request)(int id, const char *kind, const char *args);
+    /* Is the Android permission granted? 1 yes, 0 no. */
+    int (*checkPermission)(const char *permission);
+    /* What the soft keyboard should offer: TKA_INPUT_*. */
+    void (*inputMode)(int mode);
+    /* The screen as an accessibility snapshot (see library/a11y.tcl), sent when it changes. */
+    void (*a11yTree)(const char *snapshot);
+} TkAHost;
+
+enum { TKA_INPUT_CODE, TKA_INPUT_TEXT, TKA_INPUT_NUMBER, TKA_INPUT_EMAIL, TKA_INPUT_URL, TKA_INPUT_PASSWORD };
+
+enum { TKA_HAPTIC_TICK, TKA_HAPTIC_CLICK, TKA_HAPTIC_HEAVY, TKA_HAPTIC_CONFIRM, TKA_HAPTIC_REJECT };
+enum { TKA_LIFE_PAUSE, TKA_LIFE_RESUME, TKA_LIFE_LOWMEMORY };
+
+#define TKA_MENU_CUT 1
+#define TKA_MENU_COPY 2
+#define TKA_MENU_PASTE 4
+#define TKA_MENU_SELECTALL 8
+
+extern TkAHost tkAHost;
+void TkAndroidSetHost(const TkAHost *host);
+void TkAndroidSetScreen(int width, int height, double dpi);
+void TkAndroidResize(int width, int height, double dpi);	/* Tcl thread */
+
+/* ---- text engine ------------------------------------------------------- */
+
+typedef struct TkAFontInfo {
+    int ascent, descent, maxWidth, fixed;
+} TkAFontInfo;
+
+typedef struct TkATextEngine {
+    /* Open a font; family may be NULL for the default. Returns NULL on failure. */
+    void *(*open)(const char *family, int pixelSize, int bold, int italic,
+	    TkAFontInfo *info);
+    void (*close)(void *font);
+    /* Advance width in pixels of a UTF-8 string. */
+    int (*measure)(void *font, const char *utf8, int nbytes);
+    /* Render a UTF-8 string. Returns a malloc'd alpha mask (*w x *h bytes) whose
+     * baseline is *baseline rows from the top; NULL if nothing to draw. */
+    uint8_t *(*render)(void *font, const char *utf8, int nbytes, int *w, int *h,
+	    int *baseline);
+    /* Report available family names. */
+    void (*families)(void (*add)(void *ctx, const char *name), void *ctx);
+} TkATextEngine;
+
+extern const TkATextEngine *tkAEngine;
+void TkAndroidSetTextEngine(const TkATextEngine *engine);
+const TkATextEngine *TkAGetBuiltinEngine(void);	/* NULL if none compiled in */
+
+/* ---- thread-safe input from the UI thread -------------------------------------------- */
+
+/* action: 0 down, 1 up, 2 move, 3 cancel (android.view.MotionEvent). */
+void TkAQueueTouch(int action, int x, int y);
+/* A character key (unicode != 0) or a special key given as an X keysym. */
+void TkAQueueKey(int down, int keysym, int unicode, int state);
+void TkAQueueBack(void);
+void TkAQueueResize(int w, int h, int dpi);
+/* The system clipboard changed (in any app, including ours). */
+void TkAQueueClipboardChanged(void);
+/* The finger has stayed down in place (x, y) long enough: a long press. */
+void TkAQueueLongPress(int x, int y);
+/* Two-finger pinch. phase: 0 start, 1 update, 2 end; (x, y) the focal point; scale1000 the
+ * cumulative scale since the start, times 1000. */
+void TkAQueuePinch(int phase, int x, int y, int scale1000);
+/* The Activity paused / resumed / is short of memory (TKA_LIFE_*): Tk generates
+ * <<AndroidPause>> + <<AndroidSaveState>>, <<AndroidResume>>, <<AndroidLowMemory>> on ".". */
+void TkAQueueLifecycle(int kind);
+/* Answer to a host->request: status is "ok", "error", "cancelled" or "denied"; payload is text
+ * (newline-separated items). Thread-safe; strings are copied. */
+void TkAQueueResult(int id, const char *status, const char *payload);
+/* Accessibility: a screen reader started/stopped (on = 1/0); and an action it asked for on a node
+ * (node id from the snapshot; action is an AccessibilityNodeInfo action constant; text for set-text). */
+void TkAQueueA11yEnable(int on);
+void TkAQueueA11yAction(int id, int action, const char *text);
+/* A choice from the text toolbar: TKA_MENU_CUT, _COPY, _PASTE or _SELECTALL. */
+void TkAQueueTextAction(int action);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* TKANDROID_H */
diff --git a/android/tkAndroidColor.c b/android/tkAndroidColor.c
new file mode 100644
index 0000000..15967c2
--- /dev/null
+++ b/android/tkAndroidColor.c
@@ -0,0 +1,291 @@
+/*
+ * tkAndroidColor.c --
+ *
+ *	Colours (a TrueColor visual: pixel = 0x00RRGGBB), cursors (accepted and
+ *	ignored: touch devices have no pointer shape), and the selection and
+ *	clipboard hooks.
+ */
+
+#include "tkAndroidPriv.h"
+#include "tkColor.h"
+#include "tkSelect.h"
+
+static unsigned long
+PixelOf(const XColor *c)
+{
+    return ((unsigned long) (c->red >> 8) << 16) | ((unsigned long) (c->green >> 8) << 8)
+	    | (unsigned long) (c->blue >> 8);
+}
+
+TkColor *
+TkpGetColor(Tk_Window tkwin, const char *name)
+{
+    XColor c;
+    TkColor *t;
+
+    memset(&c, 0, sizeof(c));
+    if (!XParseColor(Tk_Display(tkwin), 1, name, &c)) {
+	return NULL;
+    }
+    t = (TkColor *) ckalloc(sizeof(TkColor));
+    memset(t, 0, sizeof(TkColor));
+    t->color = c;
+    t->color.pixel = PixelOf(&c);
+    return t;
+}
+
+TkColor *
+TkpGetColorByValue(Tk_Window tkwin, XColor *colorPtr)
+{
+    TkColor *t = (TkColor *) ckalloc(sizeof(TkColor));
+
+    (void) tkwin;
+    memset(t, 0, sizeof(TkColor));
+    t->color.red = colorPtr->red;
+    t->color.green = colorPtr->green;
+    t->color.blue = colorPtr->blue;
+    t->color.pixel = PixelOf(colorPtr);
+    return t;
+}
+
+Status
+XAllocColor(Display *d, Colormap c, XColor *xp)
+{
+    (void) d; (void) c;
+    xp->pixel = PixelOf(xp);
+    return 1;
+}
+
+int
+XQueryColors(Display *d, Colormap c, XColor *colors, int n)
+{
+    int i;
+
+    (void) d; (void) c;
+    for (i = 0; i < n; i++) {
+	unsigned long p = colors[i].pixel;
+
+	colors[i].red = (unsigned short) (((p >> 16) & 0xFF) * 257);
+	colors[i].green = (unsigned short) (((p >> 8) & 0xFF) * 257);
+	colors[i].blue = (unsigned short) ((p & 0xFF) * 257);
+    }
+    return 1;
+}
+
+Status
+XLookupColor(Display *d, Colormap c, const char *name, XColor *exact, XColor *screen)
+{
+    if (!XParseColor(d, c, name, exact)) {
+	return 0;
+    }
+    exact->pixel = PixelOf(exact);
+    *screen = *exact;
+    return 1;
+}
+
+int
+XFreeColors(Display *d, Colormap c, unsigned long *pixels, int n, unsigned long planes)
+{
+    (void) d; (void) c; (void) pixels; (void) n; (void) planes;
+    return 1;
+}
+
+/* ---- cursors ------------------------------------------------------------------------- */
+
+static TkCursor *
+NewCursor(void)
+{
+    static unsigned long nextId = 1;	/* Tk keeps a table keyed by id: each must be unique */
+    TkCursor *c = (TkCursor *) ckalloc(sizeof(TkCursor));
+
+    memset(c, 0, sizeof(TkCursor));
+    c->cursor = (Tk_Cursor) nextId++;
+    return c;
+}
+
+/* The names of Tk's cursors: X11's cursor font (77) and Tk's own extras. There is no pointer on a
+ * touch screen, so no cursor is ever shown, but a script's cursor spec is still validated exactly as
+ * upstream does (unix/tkUnixCursor.c), so a typo is an error here as on every other platform. */
+static const char *const cursorNames[] = {
+    "X_cursor",
+    "arrow",
+    "based_arrow_down",
+    "based_arrow_up",
+    "boat",
+    "bogosity",
+    "bottom_left_corner",
+    "bottom_right_corner",
+    "bottom_side",
+    "bottom_tee",
+    "box_spiral",
+    "center_ptr",
+    "circle",
+    "clock",
+    "coffee_mug",
+    "cross",
+    "cross_reverse",
+    "crosshair",
+    "diamond_cross",
+    "dot",
+    "dotbox",
+    "double_arrow",
+    "draft_large",
+    "draft_small",
+    "draped_box",
+    "exchange",
+    "fleur",
+    "gobbler",
+    "gumby",
+    "hand1",
+    "hand2",
+    "heart",
+    "icon",
+    "iron_cross",
+    "left_ptr",
+    "left_side",
+    "left_tee",
+    "leftbutton",
+    "ll_angle",
+    "lr_angle",
+    "man",
+    "middlebutton",
+    "mouse",
+    "pencil",
+    "pirate",
+    "plus",
+    "question_arrow",
+    "right_ptr",
+    "right_side",
+    "right_tee",
+    "rightbutton",
+    "rtl_logo",
+    "sailboat",
+    "sb_down_arrow",
+    "sb_h_double_arrow",
+    "sb_left_arrow",
+    "sb_right_arrow",
+    "sb_up_arrow",
+    "sb_v_double_arrow",
+    "shuttle",
+    "sizing",
+    "spider",
+    "spraycan",
+    "star",
+    "target",
+    "tcross",
+    "top_left_arrow",
+    "top_left_corner",
+    "top_right_corner",
+    "top_side",
+    "top_tee",
+    "trek",
+    "ul_angle",
+    "umbrella",
+    "ur_angle",
+    "watch",
+    "xterm",
+    "none",
+    "myarrow",
+    NULL
+};
+
+TkCursor *
+TkGetCursorByName(Tcl_Interp *interp, Tk_Window tkwin, const char *string)
+{
+    Tcl_Size argc;
+    const char **argv = NULL;
+    TkCursor *result = NULL;
+    XColor color;
+    int known = 0, i;
+
+    if (Tcl_SplitList(interp, string, &argc, &argv) != TCL_OK) {
+	return NULL;
+    }
+    if (argc == 0) {
+	goto bad;
+    }
+    if (argv[0][0] == '@') {
+	/* a cursor from bitmap files: {src fg} or {src mask fg bg}; files are not read here */
+	if (Tcl_IsSafe(interp)) {
+	    Tcl_SetObjResult(interp, Tcl_NewStringObj(
+		    "cannot get cursor from a file in a safe interpreter", TCL_AUTO_LENGTH));
+	    Tcl_SetErrorCode(interp, "TK", "SAFE", "CURSOR_FILE", (char *) NULL);
+	    goto done;
+	}
+	if (argc != 2 && argc != 4) {
+	    goto bad;
+	}
+    } else {
+	if (argc > 3) {
+	    goto bad;
+	}
+	for (i = 0; cursorNames[i] != NULL; i++) {
+	    if (strcmp(cursorNames[i], argv[0]) == 0) {
+		known = 1;
+		break;
+	    }
+	}
+	if (!known) {
+	    goto bad;
+	}
+    }
+    for (i = (argv[0][0] == '@' ? (int) argc - 2 : 1); i < (int) argc; i++) {
+	if (argv[0][0] == '@' && i < (int) argc - 2) {
+	    continue;
+	}
+	if (TkParseColor(Tk_Display(tkwin), Tk_Colormap(tkwin), argv[i], &color) == 0) {
+	    Tcl_SetObjResult(interp, Tcl_ObjPrintf("invalid color name \"%s\"", argv[i]));
+	    Tcl_SetErrorCode(interp, "TK", "CURSOR", "COLOR", (char *) NULL);
+	    goto done;
+	}
+    }
+    result = NewCursor();
+    goto done;
+
+  bad:
+    Tcl_SetObjResult(interp, Tcl_ObjPrintf("bad cursor spec \"%s\"", string));
+    Tcl_SetErrorCode(interp, "TK", "VALUE", "CURSOR", (char *) NULL);
+  done:
+    if (argv != NULL) {
+	ckfree(argv);
+    }
+    return result;
+}
+
+TkCursor *
+TkCreateCursorFromData(Tk_Window tkwin, const char *source, const char *mask,
+	int width, int height, int xHot, int yHot, XColor fg, XColor bg)
+{
+    (void) tkwin; (void) source; (void) mask; (void) width; (void) height;
+    (void) xHot; (void) yHot; (void) fg; (void) bg;
+    return NewCursor();
+}
+
+/* Platform resources only: generic/tkCursor.c frees the TkCursor record itself. */
+void TkpFreeCursor(TkCursor *cursorPtr) { (void) cursorPtr; }
+int XFreeCursor(Display *d, Cursor c) { (void) d; (void) c; return 1; }
+
+/* ---- selection owner and window properties (the clipboard itself is tkAndroidSelect.c) -------------------------- */
+
+/* Tk gave up an owner of CLIPBOARD (selection clear -selection CLIPBOARD): empty the system one too,
+ * or `clipboard get` would still find the old text there. */
+int
+XSetSelectionOwner(Display *d, Atom a, Window w, Time t)
+{
+    (void) d; (void) t;
+    if (w == None && tkA.dispPtr != NULL && a == tkA.dispPtr->clipboardAtom) {
+	TkAClipboardDisowned();
+    }
+    return 1;
+}
+int XChangeProperty(Display *d, Window w, Atom a1, Atom a2, int i1, int i2, const unsigned char *c, int i3)
+{ (void) d; (void) w; (void) a1; (void) a2; (void) i1; (void) i2; (void) c; (void) i3; return 1; }
+int XDeleteProperty(Display *d, Window w, Atom a) { (void) d; (void) w; (void) a; return 1; }
+int XGetWindowProperty(Display *d, Window w, Atom a1, long l1, long l2, Bool b, Atom a2, Atom *ap,
+	int *ip, unsigned long *ul1, unsigned long *ul2, unsigned char **cpp)
+{
+    (void) d; (void) w; (void) a1; (void) l1; (void) l2; (void) b; (void) a2;
+    *ap = None; *ip = 0; *ul1 = 0; *ul2 = 0; *cpp = NULL;
+    return 1;
+}
+char *XGetAtomName(Display *d, Atom a) { (void) d; (void) a; return NULL; }
diff --git a/android/tkAndroidDefault.h b/android/tkAndroidDefault.h
new file mode 100644
index 0000000..342db2b
--- /dev/null
+++ b/android/tkAndroidDefault.h
@@ -0,0 +1,13 @@
+/*
+ * tkAndroidDefault.h --
+ *
+ *	Default option values (colours, fonts, borders, ...) for Android.
+ *	PROVISIONAL: reuses the Unix defaults unchanged. A density-aware,
+ *	platform-appropriate set (system fonts via the Android font backend,
+ *	Material-ish colours, larger default paddings for touch) is Phase 2/3
+ *	work; see docs/compatibility-policy.md ("Product target").
+ */
+#ifndef _TKANDROIDDEFAULT
+#define _TKANDROIDDEFAULT
+#include "../unix/tkUnixDefault.h"
+#endif
diff --git a/android/tkAndroidDisplay.c b/android/tkAndroidDisplay.c
new file mode 100644
index 0000000..8e7fa57
--- /dev/null
+++ b/android/tkAndroidDisplay.c
@@ -0,0 +1,394 @@
+/*
+ * tkAndroidDisplay.c --
+ *
+ *	Display connection, initialisation, and the trivial parts of the
+ *	in-process "server" (sync, flush, errors, atoms of the application name,
+ *	things that have no meaning without an X server).
+ */
+
+/* This file builds the Display structure itself, so it needs the full definition. */
+#define XLIB_ILLEGAL_ACCESS
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE	/* Dl_info / dladdr on glibc */
+#endif
+#include "tkAndroidPriv.h"
+#include "tkBusy.h"
