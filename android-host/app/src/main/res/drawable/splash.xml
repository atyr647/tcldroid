<?xml version="1.0" encoding="utf-8"?>
<!-- Shown from the moment the app starts until Tk presents its first complete screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tcldroid_splash" />
        </shape>
    </item>
    <item android:gravity="center" android:width="96dp" android:height="96dp">
        <bitmap android:src="@drawable/app_icon" android:gravity="fill" />
    </item>
</layer-list>
